   544	def gate_call_constraints_are_satisfiable_under_budget(plan: dict) -> list[dict]:
   545	    """Arithmetic proof that every declared scenario fits under the plan's model call budget.
   546	
   547	    A plan that only adds up on the happy path is a plan that stops mid-review the first time
   548	    the Maker needs a second round, so both the straight-line and the retry scenario must be
   549	    declared and both must be shown to fit.
   550	    """
   551	    findings: list[dict] = []
   552	    budget = plan.get("budget") or {}
   553	    ceiling = int(budget.get("max_model_calls", 0))
   554	    bootstrap = int(budget.get("bootstrap_calls", 0))
   555	    per_round = budget.get("role_calls_per_round") or {}
   556	    round_cost = sum(int(value) for value in per_round.values())
   557	    gate_cost = sum(int(gate.get("model_calls", 0)) for gate in plan.get("gates") or [])
   558	    scenarios = plan.get("scenarios") or []
   559	    declared = {str(scenario.get("name")) for scenario in scenarios}
   560	    if len(declared) != len(scenarios):
   561	        findings.append({"violation": "duplicate_budget_scenario",
   562	                         "detail": "scenario names within scenarios array must be unique"})
   563	    for name in REQUIRED_BUDGET_SCENARIOS:
   564	        if name not in declared:
   565	            findings.append({"violation": "missing_budget_scenario", "scenario": name,
   566	                             "detail": "satisfiability must be proven for the straight-line and the retry scenario"})
   567	    for scenario in scenarios:
   568	        name = str(scenario.get("name"))
   569	        rounds = int(scenario.get("rework_rounds", 0))
   570	        if name == "straight_line" and rounds != 0:
   571	            findings.append({"violation": "invalid_budget_scenario_rounds", "scenario": "straight_line",
   572	                             "rework_rounds": rounds, "detail": "straight_line scenario must specify rework_rounds == 0"})
   573	        elif name == "retry" and rounds < 1:
   574	            findings.append({"violation": "invalid_budget_scenario_rounds", "scenario": "retry",
   575	                             "rework_rounds": rounds, "detail": "retry scenario must specify at least 1 rework round (rework_rounds >= 1)"})
   576	        required = bootstrap + (1 + rounds) * round_cost + gate_cost
   577	        if required > ceiling:
   578	            findings.append({"violation": "gate_call_constraints_unsatisfiable", "scenario": scenario.get("name"),
   579	                             "required_calls": required, "max_model_calls": ceiling,
   580	                             "detail": f"{bootstrap} bootstrap + {1 + rounds} round(s) x {round_cost} + {gate_cost} gate call(s)"})
   581	    return findings
   582	
   583	
   584	def validate_execution_plan(
   585	    plan: Any,
   586	    *,
   587	    repo_root: str | Path | None = None,
   588	    parent_protected_paths: list[dict] | None = None,
   589	    verify_paths: bool = False,
   590	    schema_path: str | Path | None = None,
   591	) -> dict:
   592	    """Validate one execution plan. Fail-closed: any doubt is a refusal, never a warning."""
   593	    errors: list[dict] = []
   594	    schema_file = Path(schema_path) if schema_path else SCHEMA_DIR / "execution-plan.schema.json"
   595	    valid, schema_errors = validate_against_schema_file(plan, schema_file)
   596	    if not valid:
   597	        return {"approved": False,
   598	                "errors": [{"violation": "schema_invalid", "detail": message} for message in schema_errors]}
   599	
   600	    seen_gates: set[str] = set()
   601	    for gate in plan["gates"]:
   602	        gate_id = str(gate["gate_id"])
   603	        if gate_id in seen_gates:
   604	            errors.append({"violation": "duplicate_gate_id", "gate_id": gate_id})
   605	        seen_gates.add(gate_id)
   606	        phase = str(gate["lifecycle_phase"])
   607	        if phase not in LIFECYCLE_PHASES:
   608	            errors.append({"violation": "unknown_lifecycle_phase", "gate_id": gate_id, "lifecycle_phase": phase})
   609	            continue
   610	        for assertion in gate["assertions"]:
   611	            assertion_id = str(assertion["assertion_id"])
   612	            spec = ASSERTION_REGISTRY.get(assertion_id)
   613	            if spec is None:
   614	                errors.append({"violation": "unknown_assertion", "gate_id": gate_id, "assertion_id": assertion_id,
   615	                               "detail": "assertion is not in the closed registry"})
   616	                continue
   617	            if phase not in spec["phases"]:
   618	                errors.append({"violation": "assertion_phase_mismatch", "gate_id": gate_id,
   619	                               "assertion_id": assertion_id, "lifecycle_phase": phase,
   620	                               "allowed_phases": list(spec["phases"])})
   621	            parameters = assertion.get("parameters") or {}
   622	            for name in spec["required"]:
   623	                if name not in parameters:
   624	                    errors.append({"violation": "assertion_parameter_missing", "gate_id": gate_id,
   625	                                   "assertion_id": assertion_id, "parameter": name})
   626	            for name, value in parameters.items():
   627	                declared = spec["parameters"].get(name)
   628	                if declared is None:
   629	                    errors.append({"violation": "assertion_parameter_unknown", "gate_id": gate_id,
   630	                                   "assertion_id": assertion_id, "parameter": name})
   631	                    continue
   632	                for message in validate_json_schema(value, declared, declared, f"{gate_id}.{assertion_id}.{name}"):
   633	                    errors.append({"violation": "assertion_parameter_invalid", "gate_id": gate_id,
   634	                                   "assertion_id": assertion_id, "parameter": name, "detail": message})
   635	
   636	    errors.extend(gate_call_constraints_are_satisfiable_under_budget(plan))
   637	
   638	    protected = plan.get("protected_paths") or []
   639	    for item in protected:
   640	        if item.get("policy") == "exact_file_hash" and not item.get("sha256"):
   641	            errors.append({"violation": "protected_path_missing_hash", "pattern": item.get("pattern")})
   642	        if item.get("policy") == "exact_set_snapshot" and not isinstance((item.get("snapshot") or {}).get("entries"), list):
   643	            errors.append({"violation": "protected_path_missing_snapshot", "pattern": item.get("pattern")})
   644	    if parent_protected_paths is not None:
   645	        errors.extend(assert_protected_paths_monotonic(parent_protected_paths, protected))
   646	    if verify_paths:
   647	        if repo_root is None:
   648	            errors.append({"violation": "protected_paths_unverifiable",
   649	                           "detail": "a repository root is required to verify protected paths"})
   650	        else:
   651	            errors.extend(verify_protected_paths(repo_root, protected))
   652	
   653	    return {"approved": not errors, "errors": errors, "plan_id": plan.get("plan_id"),
   654	            "plan_digest": digest_of(plan), "assertions_registered": sorted(ASSERTION_REGISTRY)}
   655	
   656	
   657	def main(argv: list[str] | None = None) -> int:
   658	    parser = argparse.ArgumentParser(description="Validate an execution plan and its protected paths (T033).")
   659	    parser.add_argument("--plan", type=Path)
   660	    parser.add_argument("--repo", type=Path, help="repository root used to verify protected paths")
   661	    parser.add_argument("--parent-plan", type=Path, help="parent plan whose protected paths must be inherited or tightened")
   662	    parser.add_argument("--verify-protected-paths", action="store_true")
   663	    parser.add_argument("--schema", type=Path)
   664	    parser.add_argument("--output", type=Path)
   665	    parser.add_argument("--print-registry", action="store_true", help="print the closed assertion registry and exit")
   666	    args = parser.parse_args(argv)
   667	
   668	    if args.print_registry:
   669	        print(json.dumps({"lifecycle_phases": list(LIFECYCLE_PHASES),
   670	                          "assertions": {name: {"phases": list(spec["phases"]), "required": list(spec["required"]),
   730	        if record is None:
   731	            raise Refusal(f"unknown global_attempt_id {global_attempt_id}", 2)
   732	        if record["state"] == "released":
   733	            return record
   734	        if record["state"] in CHARGED_ATTEMPT_STATES:
   735	            raise Refusal(
   736	                f"global_attempt_id {global_attempt_id} is already {record['state']}; a charged call is never released", 2)
   737	        self.journal.append(
   738	            "model_call_released", authority_id=self.authority_id, global_attempt_id=global_attempt_id,
   739	            logical_call_id=record.get("logical_call_id", ""), child_batch_id=record.get("child_batch_id", ""),
   740	            outcome="released", proof=str(proof))
   741	        self.refold()
   742	        self.write_status()
   743	        return self.state.attempts[global_attempt_id]
   744	
   745	    def reconcile_orphan_reservations(self, child_batch_id: str, resolver: Callable[[dict], str] | None = None) -> list[dict]:
   746	        """Settle reservations left open by a crash, conservatively unless the transport proves otherwise.
   747	
   748	        Default verdict is `ambiguous`, which charges the slot: a reservation whose outcome nobody
   749	        can prove may already have reached the provider, and releasing it would let the same budget
   750	        be spent twice.
   751	        """
   752	        self._require_lease()
   753	        self.refold()
   754	        settled: list[dict] = []
   755	        for attempt in list(self.state.attempts_for_child(child_batch_id)):
   756	            if attempt["state"] != "reserved":
   757	                continue
   758	            verdict = (resolver(attempt) if resolver else "ambiguous") or "ambiguous"
   759	            if verdict == "released":
   760	                settled.append(self.release_call(
   761	                    attempt["global_attempt_id"],
   762	                    proof="reconciliation: the transport proved this dispatch never started"))
   763	            else:
   764	                settled.append(self.consume_call(attempt["global_attempt_id"],
   765	                                                 outcome="consumed" if verdict == "consumed" else "ambiguous",
   766	                                                 receipt={"reconciled": True}))
   767	        return settled
   768	
   769	    def child_budget_projection(self, child_batch_id: str) -> dict:
   770	        """The child ledger is this projection of the authority journal, never a second ledger."""
   771	        self.refold()
   772	        attempts = self.state.attempts_for_child(child_batch_id)
   773	        granted = 0
   774	        child = self.state.children.get(child_batch_id) or {}
   775	        derivation = child.get("derivation") or {}
   776	        if derivation:
   777	            granted = int(derivation.get("granted_model_calls", 0))
   778	        return {
   779	            "child_batch_id": child_batch_id,
   780	            "granted_model_calls": granted,
   781	            "consumed_model_calls": sum(1 for a in attempts if a["state"] in CHARGED_ATTEMPT_STATES),
   782	            "reserved_model_calls": sum(1 for a in attempts if a["state"] == "reserved"),
   783	            "released_model_calls": sum(1 for a in attempts if a["state"] == "released"),
   784	            "global_attempt_ids": [a["global_attempt_id"] for a in attempts],
   785	        }
   786	
   787	    def reconcile_child_batch(self, batch: dict, child_batch_id: str) -> dict:
   788	        """On resume the authority journal is authoritative; the child ledger is rebuilt from it."""
   789	        projection = self.child_budget_projection(child_batch_id)
   790	        budget = batch.setdefault("budget", {})
   791	        budget["consumed_model_calls"] = projection["consumed_model_calls"]
   792	        budget["reserved_model_calls"] = projection["reserved_model_calls"]
   793	        budget["max_model_calls"] = projection["granted_model_calls"] or budget.get("max_model_calls", 0)
   794	        budget["pending_call"] = None
   795	        for attempt in self.state.attempts_for_child(child_batch_id):
   796	            if attempt["state"] == "reserved":
   797	                budget["pending_call"] = {
   798	                    "call_id": attempt.get("logical_call_id") or attempt["global_attempt_id"],
   799	                    "role": attempt.get("role") or "maker",
   800	                    "phase": attempt.get("phase") or "implementation",
   801	                    "payload_digest": attempt.get("payload_digest", ""),
   802	                    "global_attempt_id": attempt["global_attempt_id"],
   803	                }
   804	                break
   805	        return batch
   806	
   807	    # ---- children ----------------------------------------------------------------------
   808	
   809	    def child_proposal_path(self, child_batch_id: str) -> Path:
   810	        return self.runtime_dir / "proposals" / f"{child_batch_id}.proposal.json"
   811	
   812	    def child_proof_path(self, child_batch_id: str) -> Path:
   813	        return self.runtime_dir / "proposals" / f"{child_batch_id}.proof.json"
   814	
   815	    def get_child_proposal(self, child_batch_id: str) -> dict | None:
   816	        path = self.child_proposal_path(child_batch_id)
   817	        if path.is_file():
   818	            try:
   819	                return json.loads(path.read_text(encoding="utf-8"))
   820	            except Exception:
   821	                return None
   822	        return None
   823	
   824	    def get_child_proof(self, child_batch_id: str) -> dict | None:
   825	        path = self.child_proof_path(child_batch_id)
   826	        if path.is_file():
   827	            try:
   828	                return json.loads(path.read_text(encoding="utf-8"))
   829	            except Exception:
   830	                return None
   831	        return None
   832	
   833	    @staticmethod
   834	    def _read_canonical(path: Path, what: str, child_batch_id: str) -> dict:
   835	        try:
   836	            payload = json.loads(path.read_text(encoding="utf-8"))
   837	        except (OSError, ValueError) as exc:
   838	            raise HardStop("state_integrity",
   839	                           f"the {what} of child batch {child_batch_id} is unreadable at "
   840	                           f"{path.as_posix()}: {exc}") from exc
   841	        if not isinstance(payload, dict):
   842	            raise HardStop("state_integrity", f"the {what} of child batch {child_batch_id} is not an object")
   843	        return payload
   844	
   845	    def load_child_derivation(self, child_batch_id: str) -> tuple[dict, dict]:
   846	        """Recover the canonical child proposal and its derivation proof, re-digesting both.
   847	
   848	        A digest a batch declares is worth nothing unless the object it digests can be produced
   849	        and hashed again, so this reads the persisted objects and recomputes. A missing
   850	        derivation event, an unreadable file, or a digest that does not reproduce is a hard stop;
   851	        nothing here falls back to "close enough".
   852	        """
   853	        self.refold()
   854	        derivation = (self.state.children.get(child_batch_id) or {}).get("derivation")
   855	        if not derivation:
   856	            raise HardStop(
   857	                "authority_missing_or_ambiguous",
   858	                f"story authority {self.authority_id} never derived child batch {child_batch_id}; "
   859	                "a batch cannot claim an authority that did not authorize it",
   860	                child_batch_id=child_batch_id, derived=sorted(self.state.children))
   861	        proposal = self._read_canonical(self.child_proposal_path(child_batch_id), "child proposal", child_batch_id)
   862	        proof = self._read_canonical(self.child_proof_path(child_batch_id), "derivation proof", child_batch_id)
   863	
   864	        proposal_digest = digest_of(proposal)
   865	        if proposal_digest != derivation.get("child_proposal_digest"):
   866	            raise HardStop("state_integrity",
   867	                           f"the persisted child proposal of {child_batch_id} digests to {proposal_digest} but the "
   868	                           f"journal recorded {derivation.get('child_proposal_digest')}",
   869	                           recomputed=proposal_digest, journaled=derivation.get("child_proposal_digest"))
   870	        # The proof digests itself by construction, so it is recomputed over the proof without
   871	        # the field that only exists because the digest was already taken.
   872	        recomputed = digest_of({k: v for k, v in proof.items() if k != "derivation_proof_digest"})
   873	        if recomputed != proof.get("derivation_proof_digest") or recomputed != derivation.get("derivation_proof_digest"):
   874	            raise HardStop("state_integrity",
   875	                           f"the derivation proof of {child_batch_id} digests to {recomputed} but the proof declares "
   876	                           f"{proof.get('derivation_proof_digest')} and the journal recorded "
   877	                           f"{derivation.get('derivation_proof_digest')}")
   878	        if proof.get("child_proposal_digest") != proposal_digest:
   879	            raise HardStop("state_integrity",
   880	                           f"the derivation proof of {child_batch_id} was taken over a different child proposal")
   881	        if proof.get("root_authority_digest") != self.root_digest:
   882	            raise HardStop("authority_missing_or_ambiguous",
   883	                           f"the derivation proof of {child_batch_id} is anchored in authority "
   884	                           f"{proof.get('root_authority_digest')}, not {self.root_digest}")
   885	
   886	        # Revalidate the persisted proposal independently against the root authority envelope.
   887	        # A persisted proposal must be a strict, valid subset of the root envelope regardless
   888	        # of whether hashes matched.
   889	        assert_child_proposal_within_envelope(proposal, self.payload, self.state, self)
   890	
   891	        return proposal, proof
   892	
   893	    def record_child_derived(self, proposal: dict, proof: dict) -> dict:
   894	        self._require_lease()
   895	        self._require_open()
   896	        child_id = proposal["child_batch_id"]
   897	
   898	        # Validate proposal and proof before persisting or journaling.
   899	        assert_child_proposal_within_envelope(proposal, self.payload, self.state, self)
   900	
   901	        proposal_digest = digest_of(proposal)
   902	        if proof.get("child_proposal_digest") != proposal_digest:
   903	            self.hard_stop("state_integrity",
   904	                           f"the derivation proof of {child_id} was taken over a different child proposal")
   905	        if proof.get("root_authority_digest") != self.root_digest:
   906	            self.hard_stop("authority_missing_or_ambiguous",
   907	                           f"the derivation proof of {child_id} is anchored in authority "
   908	                           f"{proof.get('root_authority_digest')}, not {self.root_digest}")
   909	        recomputed = digest_of({k: v for k, v in proof.items() if k != "derivation_proof_digest"})
   910	        if recomputed != proof.get("derivation_proof_digest"):
   911	            self.hard_stop("state_integrity",
   912	                           f"the derivation proof of {child_id} has invalid digest {proof.get('derivation_proof_digest')}, expected {recomputed}")
   913	
   914	        # The digests below are only verifiable if the objects survive: persist them in canonical
   915	        # form so a later run can re-read and re-hash them instead of trusting a hex string.
   916	        (self.runtime_dir / "proposals").mkdir(parents=True, exist_ok=True)
   917	        _write_json_atomic(self.child_proposal_path(child_id), proposal)
   918	        _write_json_atomic(self.child_proof_path(child_id), proof)
   919	        event = self.journal.append(
   920	            "child_derived", authority_id=self.authority_id, child_batch_id=child_id,
   921	            parent_child_batch_id=proposal.get("parent_child_batch_id"),
   922	            root_authority_digest=proof["root_authority_digest"],
   923	            parent_authority_digest=proof["parent_authority_digest"],
   924	            parent_batch_digest=proof["parent_batch_digest"],
   925	            child_proposal_digest=proof["child_proposal_digest"],
   926	            derivation_proof_digest=proof["derivation_proof_digest"],
   927	            granted_model_calls=int(proposal["model_call_budget"]),
   928	            functional_parent_checkpoint=proposal.get("functional_parent_checkpoint"),
   929	            unresolved_action_items_digest=proof.get("unresolved_action_items_digest", ""))
   930	        self.refold()
   931	        self.write_status()
   932	        return event
   933	
   934	    def record_child_open(self, child_batch_id: str, *, branch: str, head_commit: str, tree: str) -> dict:
   935	        self._require_lease()
   936	        self._require_open()
   937	        event = self.journal.append(
   938	            "child_open", authority_id=self.authority_id, child_batch_id=child_batch_id, branch=branch,
   939	            head_commit=head_commit, tree=tree)
   940	        self.refold()
   941	        self.write_status()
   942	        return event
   943	
   944	    def record_child_closed(
   945	        self,
   946	        *,
   947	        child_batch_id: str,
   948	        governance_base_commit: str,
   949	        checker_reviewed_commit: str,
   950	        checker_reviewed_tree: str,
   951	        functional_checkpoint_commit: str,
   952	        functional_checkpoint_tree: str,
   953	        checker_verdict: str,
   954	        unresolved_action_items: list[dict] | None = None,
   955	        unresolved_digest: str | None = None,
   956	    ) -> dict:
   957	        """Persist the functional lineage of a closing child, merged or not."""
   958	        self._require_lease()
   959	        self._require_open()
   960	        for name, value in (("governance_base_commit", governance_base_commit),
   961	                            ("checker_reviewed_commit", checker_reviewed_commit),
   962	                            ("functional_checkpoint_commit", functional_checkpoint_commit)):
   963	            if not _COMMIT_RE.match(str(value)):
   964	                raise Refusal(f"{name} must be a full 40 character commit sha, got {value!r}")
   965	        digest = unresolved_digest if unresolved_digest is not None else unresolved_action_items_digest(
   966	            unresolved_action_items or [])
   967	        inherited = ((self.state.children.get(child_batch_id) or {}).get("derivation") or {}).get(
   968	            "functional_parent_checkpoint") or {}
   969	        made_progress = checker_reviewed_tree != inherited.get("tree")
   970	        event = self.journal.append(
   971	            "child_closed", authority_id=self.authority_id, child_batch_id=child_batch_id,
   972	            governance_base_commit=governance_base_commit, checker_reviewed_commit=checker_reviewed_commit,
   973	            checker_reviewed_tree=checker_reviewed_tree,
   974	            functional_checkpoint_commit=functional_checkpoint_commit,
   975	            functional_checkpoint_tree=functional_checkpoint_tree, checker_verdict=checker_verdict,
   976	            unresolved_action_items_digest=digest, made_progress=made_progress)
   977	        self.refold()
   978	        self.write_status()
   979	        return event
   980	
   981	    def record_child_failed(self, child_batch_id: str, *, reason: str, detail: str = "") -> dict:
   982	        self._require_lease()
   983	        event = self.journal.append(
   984	            "child_failed", authority_id=self.authority_id, child_batch_id=child_batch_id, reason=reason,
   985	            detail=detail[:400])
   986	        self.refold()
   987	        self.write_status()
   988	        return event
