    14	class ChildDerivationTest(StoryCase):
    15	
    16	    def base_child(self, auth, **overrides) -> dict:
    17	        proposal = story.derive_child_proposal(
    18	            authority=auth, child_batch_id="B013", action_items=[], previous_child_id=None,
    19	            model_call_budget=8, governance_base_commit=self.governance_base,
    20	            story_baseline_commit=self.governance_base)
    21	        proposal.update(overrides)
