    23	from scripts.tests.test_tl_runtime import CHECKER_OK, MAKER_OK, Fixture, SPEC_A, git  # noqa: E402
    24	from tl_merge_guard import temporary_platform_anchor_for_testing  # noqa: E402
    25	from scripts.fixtures.runtime.fake_gh import TEST_FIXTURE_KEY_ID, TEST_FIXTURE_PUBLIC_KEY  # noqa: E402
    26	
    27	PATCH_ITEM = {
    28	    "id": "R5", "severity": "medium", "category": "patch", "target_role": "maker",
    29	    "location": "pkg/greet.py:1", "problem": "greet() returns an unbounded value",
    30	    "evidence": "the compile gate passes but the acceptance criterion is unmet",
    31	    "required_action": "return the bounded greeting",
