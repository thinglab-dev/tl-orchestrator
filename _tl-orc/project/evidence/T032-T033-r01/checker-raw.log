   612	            for name in spec["required"]:
   613	                if name not in parameters:
   614	                    errors.append({"violation": "assertion_parameter_missing", "gate_id": gate_id,
   615	                                   "assertion_id": assertion_id, "parameter": name})
   616	            for name, value in parameters.items():
   617	                declared = spec["parameters"].get(name)
   618	                if declared is None:
   619	                    errors.append({"violation": "assertion_parameter_unknown", "gate_id": gate_id,
   620	                                   "assertion_id": assertion_id, "parameter": name})
   621	                    continue
   622	                for message in validate_json_schema(value, declared, declared, f"{gate_id}.{assertion_id}.{name}"):
   623	                    errors.append({"violation": "assertion_parameter_invalid", "gate_id": gate_id,
   624	                                   "assertion_id": assertion_id, "parameter": name, "detail": message})
   625	
   626	    errors.extend(gate_call_constraints_are_satisfiable_under_budget(plan))
   627	
   628	    protected = plan.get("protected_paths") or []
   629	    for item in protected:
   630	        if item.get("policy") == "exact_file_hash" and not item.get("sha256"):
   631	            errors.append({"violation": "protected_path_missing_hash", "pattern": item.get("pattern")})
   632	        if item.get("policy") == "exact_set_snapshot" and not isinstance((item.get("snapshot") or {}).get("entries"), list):
   633	            errors.append({"violation": "protected_path_missing_snapshot", "pattern": item.get("pattern")})
   634	    if parent_protected_paths is not None:
   635	        errors.extend(assert_protected_paths_monotonic(parent_protected_paths, protected))
   636	    if verify_paths:
   637	        if repo_root is None:
   638	            errors.append({"violation": "protected_paths_unverifiable",
   639	                           "detail": "a repository root is required to verify protected paths"})
   640	        else:
   641	            errors.extend(verify_protected_paths(repo_root, protected))
   642	
   643	    return {"approved": not errors, "errors": errors, "plan_id": plan.get("plan_id"),
   644	            "plan_digest": digest_of(plan), "assertions_registered": sorted(ASSERTION_REGISTRY)}
