   296	def freeze_authority(payload: dict, *, authorized_literal: str, authority_source: str, authorized_at: str | None = None) -> dict:
   297	    """Bind the human decision to the payload. Refuses anything but the exact canonical literal."""
   298	    digest = root_authority_digest(payload)
   299	    work_ref, authorized_digest = parse_authorization_literal(authorized_literal)
   300	    if work_ref != payload["work_ref"]:
   301	        raise Refusal(
   302	            f"authority_missing_or_ambiguous: authorization names Story {work_ref!r} but the payload is for "
   303	            f"{payload['work_ref']!r}", 2)
   304	    if authorized_digest != digest:
   305	        raise Refusal(
   306	            f"authority_missing_or_ambiguous: authorization carries digest {authorized_digest} but the payload "
   307	            f"digests to {digest}", 2)
   308	    if not str(authority_source).strip():
   309	        raise Refusal("operator_authorization.authority_source must name where the decision was captured")
   310	    envelope = {
   311	        "authority_payload": payload,
   312	        "root_authority_digest": digest,
   313	        "operator_authorization": {
   314	            "authority_source": str(authority_source),
   315	            "authorized_at": _require_timestamp(authorized_at or now_iso(), "authorized_at"),
   660	        raise Refusal(f"unexpected_revision_drift: frozen_scope digest {declared} != {expected}", 2)
   661	    ids = [u["work_ref"] for u in units]
   662	    if len(ids) != len(set(ids)):
   663	        raise Refusal("duplicate work_ref in frozen_scope.units")
   664	    for unit in units:
   665	        for dep in unit.get("dependencies", []):
   666	            if dep not in ids:
   667	                raise Refusal(f"new_work_outside_frozen_batch: {unit['work_ref']} depends on {dep} outside the batch", 2)
   668	    # T032: strictly opt-in. A batch with no story_authority_mode keeps the legacy single-batch
   669	    # semantics (direct_proposal) unchanged, which is what every pre-T032 fixture declares.
   670	    mode = auth.get("story_authority_mode", "direct_proposal")
   671	    if mode not in {"direct_proposal", "AUTO_STORY"}:
   672	        raise Refusal(f"authorization.story_authority_mode must be direct_proposal or AUTO_STORY, got {mode!r}", 2)
   673	    if mode == "AUTO_STORY":
   674	        if story_authority is None:
   675	            raise Refusal("AUTO_STORY requires scripts/tl_story_authority.py, which could not be imported", 2)
   676	        for key in ("story_authority_id", "root_authority_digest", "child_proposal_digest", "derivation_proof_digest"):
   677	            if not auth.get(key):
   678	                raise Refusal(f"authority_missing_or_ambiguous: AUTO_STORY batch is missing authorization.{key}", 2)
   679	    return batch
