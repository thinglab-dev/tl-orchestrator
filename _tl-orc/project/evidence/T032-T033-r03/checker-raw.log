  1732	def assert_merge_authority(payload: dict, receipt: Any, *, trust_root: Any = None, expected_repo: str | None = None) -> Any:
  1733	    """`allowed_effects.merge` is a capability flag, never a bypass of the T028 authority gate."""
  1734	    if not payload["allowed_effects"].get("merge"):
  1735	        raise HardStop("effect_expansion", "the authority does not allow the merge effect")
  1736	    if receipt is None:
  1737	        raise HardStop("authority_missing_or_ambiguous",
  1738	                       "a merge on a protected branch requires an out-of-band T028 authority receipt")
  1739	    if not getattr(receipt, "is_confirmed", False):
  1740	        raise HardStop("authority_missing_or_ambiguous",
  1741	                       f"T028 merge authority receipt is {getattr(receipt, 'status', 'absent')}: "
  1742	                       f"{getattr(receipt, 'reason', '')}")
  1743	    authentic = getattr(receipt, "is_authentic", None)
  1744	    if callable(authentic) and not authentic(trust_root, expected_repo):
  1745	        raise HardStop("authority_missing_or_ambiguous",
  1746	                       "the T028 merge authority receipt did not verify against the platform trust root")
  1747	    return receipt
