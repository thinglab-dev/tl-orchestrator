    31	# --------------------------------------------------------------------------- canonical form
    32	
    33	# canonical_json_v1: UTF-8, object keys sorted lexicographically, compact deterministic
    34	# separators, no incidental whitespace, array order preserved. No float is admitted: a
    35	# digest that depends on a binary floating point representation is not a digest.
    36	
    37	
    38	def canonical_json(payload: Any) -> str:
    39	    _reject_floats(payload, "$")
    40	    return json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    41	
    42	
    43	def _reject_floats(value: Any, path: str) -> None:
    44	    if isinstance(value, float):
    45	        raise ValueError(f"{path}: float values are not admitted in canonical JSON")
    46	    if isinstance(value, dict):
    47	        for key, item in value.items():
    48	            if not isinstance(key, str):
    49	                raise ValueError(f"{path}: object keys must be strings, got {type(key).__name__}")
    50	            _reject_floats(item, f"{path}.{key}")
    51	    elif isinstance(value, (list, tuple)):
    52	        for index, item in enumerate(value):
    53	            _reject_floats(item, f"{path}[{index}]")
    54	
    55	
    56	def sha256_hex(data: str | bytes) -> str:
    57	    return hashlib.sha256(data.encode("utf-8") if isinstance(data, str) else data).hexdigest()
    58	
    59	
    60	def digest_of(payload: Any) -> str:
    61	    return sha256_hex(canonical_json(payload))
