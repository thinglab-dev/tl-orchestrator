   271	LIFECYCLE_PHASES = (
   272	    "pre_execution",
   273	    "post_maker_pre_review",
   274	    "post_checker_pre_merge",
   275	    "post_merge_pre_close",
   276	    "post_terminal",
   277	)
   278	
   279	_SHA40 = {"type": "string", "pattern": "^[0-9a-f]{40}$"}
   280	_SHA256 = {"type": "string", "pattern": "^[0-9a-f]{64}$"}
   281	_NAME = {"type": "string", "minLength": 1}
   282	
   283	# The closed registry. `phases` is the exhaustive set of lifecycle phases in which the
   284	# assertion is decidable; anywhere else its answer is either not yet determined or already
   285	# stale, and evaluating it there would report a truth about the wrong moment.
   286	ASSERTION_REGISTRY: dict[str, dict[str, Any]] = {
   287	    "checker_approved": {
   288	        "phases": ("post_checker_pre_merge",),
   289	        "parameters": {"unit": _NAME, "reviewed_commit": _SHA40},
   290	        "required": ("unit", "reviewed_commit"),
   291	        "description": "The independent Checker returned `approved` with zero action items for this exact commit.",
   292	    },
   293	    "main_not_merged": {
   294	        "phases": ("post_checker_pre_merge",),
   295	        "parameters": {"branch": _NAME},
   296	        "required": ("branch",),
   297	        "description": "The integration branch has not yet been merged into the protected branch.",
