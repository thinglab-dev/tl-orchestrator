   352	# --------------------------------------------------------------------------- protected paths
   353	
   354	PROTECTED_PATH_POLICIES = ("read_only", "exact_file_hash", "exact_set_snapshot")
   355	# Ordered from least to most constraining. A child may move right, never left.
   356	_POLICY_STRICTNESS = {"read_only": 0, "exact_file_hash": 1, "exact_set_snapshot": 2}
