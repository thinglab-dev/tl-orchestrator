   513	    events: int = 0
   514	    opened: bool = False
   515	    opened_at: str = ""
   516	    root_authority_digest: str = ""
   517	    global_model_call_budget: int = 0
   518	    attempts: dict[str, dict] = field(default_factory=dict)
   519	    attempt_order: list[str] = field(default_factory=list)
   520	    children: dict[str, dict] = field(default_factory=dict)
