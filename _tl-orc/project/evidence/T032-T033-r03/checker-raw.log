   990	    def assert_failure_streak(self) -> None:
   991	        limit = int(self.payload["max_consecutive_failed_batches"])
   992	        if self.state.consecutive_failures >= limit:
   993	            self.hard_stop("consecutive_batch_failures_exhausted",
   994	                           f"{self.state.consecutive_failures} consecutive child batches closed without progress "
   995	                           f"(limit {limit})")
