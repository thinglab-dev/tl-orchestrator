  1051	            "consecutive_failures": state.consecutive_failures,
  1052	            "max_child_batches": self.payload["max_child_batches"],
  1053	            "hard_stops": [{"reason": e.get("reason"), "detail": e.get("detail")} for e in state.hard_stops],
  1054	            "events": state.events,
