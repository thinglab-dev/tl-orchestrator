  1426	
  1427	    def check(name: str, ok: bool, reason: str, detail: str = "", **evidence: Any) -> None:
  1428	        checks.append({"check": name, "result": "pass" if ok else "fail"})
  1429	        if not ok:
  1430	            authority.hard_stop(reason, f"{name}: {detail}", check=name, **evidence)
  1431	
  1432	    valid, errors = validate_against_schema_file(child_proposal, CHILD_PROPOSAL_SCHEMA)
  1433	    check("child_proposal_schema", valid, "state_integrity", str(errors))
