   142	    # ---- §2.8 mechanical barrier ---------------------------------------------------------
   143	
   144	    def test_worker_cannot_invoke_a_cognitive_cli_directly(self) -> None:
   145	        probe = self.root / "probe.json"
   146	        script = (
   147	            "import json,subprocess,sys,pathlib;"
   148	            "r=subprocess.run(['codex','exec','write the patch'],capture_output=True,text=True);"
   149	            f"pathlib.Path({str(probe)!r}).write_text(json.dumps("
   150	            "{'code':r.returncode,'err':r.stderr[-300:],'out':r.stdout[-300:]}))"
   151	        )
   152	        fx = self.auto_story_fixture()
   153	        fx.script("maker", [{"files": MAKER_OK[0]["files"], "argv": [sys.executable, "-c", script]}])
   154	        fx.script("checker", CHECKER_OK)
   155	        state = fx.runtime().run()
   156	        self.assertEqual(state, "done")
