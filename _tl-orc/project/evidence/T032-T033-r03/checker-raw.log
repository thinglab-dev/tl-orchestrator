  1572	def _git(repo: str | Path, *args: str, timeout: float = 120) -> tuple[int, str, str]:
  1573	    record = subprocess.run(["git", *args], cwd=str(repo), capture_output=True, text=True, check=False, timeout=timeout)
  1574	    return record.returncode, record.stdout.strip(), record.stderr.strip()
