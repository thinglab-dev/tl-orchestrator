                     tokens |= {Path(a).name for a in argv if Path(a).suffix in {".py", ".sh", ".ps1", ".js", ".ts"}}
                     if any(token and token in summary for token in tokens):
                         matched = True
                         break
             (resolved if matched else remaining).append(item)
         return resolved, remaining
 
