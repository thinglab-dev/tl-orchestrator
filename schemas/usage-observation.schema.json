{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tl-orchestrator Harness Usage Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "session_ref_digest",
    "harness",
    "harness_version",
    "source_format",
    "source_format_fingerprint",
    "parser_status",
    "completeness",
    "timing",
    "raw_usage",
    "derived_usage",
    "observed_contexts",
    "thread_topology",
    "rate_limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "session_ref_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "harness": {
      "type": "string",
      "enum": ["codex", "claude"]
    },
    "harness_version": {
      "type": ["string", "null"]
    },
    "source_format": {
      "type": "string",
      "enum": ["codex_session_jsonl", "claude_session_jsonl"]
    },
    "source_format_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "enum": ["harness_native_log"]
    },
    "parser_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "parser_version", "reasons"],
      "properties": {
        "status": {
          "enum": ["supported", "partial", "unsupported"]
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": {
          "enum": ["complete", "incomplete", "not_observable"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_session_span_seconds",
        "first_timestamp",
        "last_timestamp",
        "source",
        "job_wall_seconds",
        "model_latency_seconds"
      ],
      "properties": {
        "observed_session_span_seconds": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "const": "not_observable" }
          ]
        },
        "first_timestamp": {
          "type": ["string", "null"]
        },
        "last_timestamp": {
          "type": ["string", "null"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "job_wall_seconds": {
          "const": "not_observable"
        },
        "model_latency_seconds": {
          "const": "not_observable"
        }
      }
    },
    "raw_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cumulative",
        "per_response_sum",
        "reconciliation",
        "response_count"
      ],
      "properties": {
        "cumulative": {
          "$ref": "#/$defs/token_counters"
        },
        "per_response_sum": {
          "$ref": "#/$defs/token_counters"
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "fields"],
          "properties": {
            "status": {
              "enum": ["reconciled", "divergent", "not_observable"]
            },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_tokens",
                "cached_input_tokens",
                "cache_write_input_tokens",
                "output_tokens",
                "reasoning_output_tokens",
                "total_tokens"
              ],
              "properties": {
                "input_tokens": { "$ref": "#/$defs/field_reconciliation" },
                "cached_input_tokens": { "$ref": "#/$defs/field_reconciliation" },
                "cache_write_input_tokens": { "$ref": "#/$defs/field_reconciliation" },
                "output_tokens": { "$ref": "#/$defs/field_reconciliation" },
                "reasoning_output_tokens": { "$ref": "#/$defs/field_reconciliation" },
                "total_tokens": { "$ref": "#/$defs/field_reconciliation" }
              }
            }
          }
        },
        "response_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "derived_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncached_input_tokens"],
      "properties": {
        "uncached_input_tokens": {
          "$ref": "#/$defs/derived_metric"
        }
      }
    },
    "observed_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "effort", "turn_count", "raw_usage"],
        "properties": {
          "model": {
            "type": ["string", "null"]
          },
          "effort": {
            "type": ["string", "null"]
          },
          "turn_count": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              { "const": "not_observable" }
            ]
          },
          "raw_usage": {
            "oneOf": [
              { "$ref": "#/$defs/token_counters" },
              { "$ref": "#/$defs/claude_native_counters" }
            ]
          }
        }
      }
    },
    "thread_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_thread_id", "session_id", "threads"],
      "properties": {
        "root_thread_id": {
          "type": ["string", "null"]
        },
        "session_id": {
          "type": ["string", "null"]
        },
        "threads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["thread_id", "parent_thread_id", "role", "turn_count"],
            "properties": {
              "thread_id": {
                "type": "string"
              },
              "parent_thread_id": {
                "type": ["string", "null"]
              },
              "role": {
                "enum": ["root", "child", "auto_review", "guardian"]
              },
              "turn_count": {
                "oneOf": [
                  { "type": "integer", "minimum": 0 },
                  { "const": "not_observable" }
                ]
              },
              "tool_use_id": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "rate_limits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "attribution", "limit_id", "primary", "secondary", "plan_type"],
        "properties": {
          "scope": {
            "const": "account"
          },
          "attribution": {
            "const": "unknown"
          },
          "limit_id": {
            "type": ["string", "null"]
          },
          "limit_name": {
            "type": ["string", "null"]
          },
          "primary": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["used_percent", "window_minutes", "resets_at"],
            "properties": {
              "used_percent": { "type": ["number", "null"] },
              "window_minutes": { "type": ["number", "null"] },
              "resets_at": { "type": ["number", "null"] }
            }
          },
          "secondary": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["used_percent", "window_minutes", "resets_at"],
            "properties": {
              "used_percent": { "type": ["number", "null"] },
              "window_minutes": { "type": ["number", "null"] },
              "resets_at": { "type": ["number", "null"] }
            }
          },
          "plan_type": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "raw_usage_channels": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "token_usage_records",
            "event_msg_token_counts",
            "cumulative_snapshots"
          ],
          "properties": {
            "token_usage_records": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_count", "per_response_sum"],
              "properties": {
                "event_count": { "type": "integer", "minimum": 0 },
                "per_response_sum": { "$ref": "#/$defs/token_counters" }
              }
            },
            "event_msg_token_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_count", "per_response_sum"],
              "properties": {
                "event_count": { "type": "integer", "minimum": 0 },
                "per_response_sum": { "$ref": "#/$defs/token_counters" }
              }
            },
            "cumulative_snapshots": {
              "type": "object",
              "additionalProperties": false,
              "required": ["snapshot_count", "latest_snapshot"],
              "properties": {
                "snapshot_count": { "type": "integer", "minimum": 0 },
                "latest_snapshot": { "$ref": "#/$defs/token_counters" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claude_assistant_messages",
            "claude_unique_responses"
          ],
          "properties": {
            "claude_assistant_messages": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_count", "native_counters_sum"],
              "properties": {
                "status": {
                  "enum": ["exact", "truncated", "not_observable"]
                },
                "event_count": {
                  "oneOf": [
                    { "type": "integer", "minimum": 0 },
                    { "const": "not_observable" }
                  ]
                },
                "native_counters_sum": { "$ref": "#/$defs/claude_native_counters" }
              }
            },
            "claude_unique_responses": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_count", "native_counters_sum"],
              "properties": {
                "status": {
                  "enum": ["exact", "truncated", "not_observable"]
                },
                "event_count": {
                  "oneOf": [
                    { "type": "integer", "minimum": 0 },
                    { "const": "not_observable" }
                  ]
                },
                "native_counters_sum": { "$ref": "#/$defs/claude_native_counters" }
              }
            }
          }
        }
      ]
    },
    "semantic_correlations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "summary",
        "records"
      ],
      "properties": {
        "rule_id": {
          "type": ["string", "null"]
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "records_observed",
            "records_retained",
            "records_truncated",
            "correlated_events",
            "ambiguous_events",
            "unmatched_events"
          ],
          "properties": {
            "records_observed": { "type": "integer", "minimum": 0 },
            "records_retained": { "type": "integer", "minimum": 0 },
            "records_truncated": { "type": "boolean" },
            "correlated_events": { "type": "integer", "minimum": 0 },
            "ambiguous_events": { "type": "integer", "minimum": 0 },
            "unmatched_events": { "type": "integer", "minimum": 0 }
          }
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "correlation_id",
              "status",
              "strategy",
              "response_id",
              "turn_id",
              "thread_id",
              "channels",
              "counters",
              "reasons"
            ],
            "properties": {
              "correlation_id": { "type": "string", "minLength": 1 },
              "status": {
                "enum": ["correlated", "ambiguous", "unmatched"]
              },
              "strategy": {
                "enum": ["exact_identity", "versioned_structural_relation", "none"]
              },
              "response_id": { "type": ["string", "null"] },
              "turn_id": { "type": ["string", "null"] },
              "thread_id": { "type": ["string", "null"] },
              "channels": {
                "type": "array",
                "items": { "type": "string" }
              },
              "counters": {
                "oneOf": [
                  { "$ref": "#/$defs/token_counters" },
                  { "$ref": "#/$defs/claude_native_counters" }
                ]
              },
              "response_kind": {
                "enum": ["model", "synthetic", "unknown"]
              },
              "reasons": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "normalized_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rule_id",
        "eligible_for_normalization",
        "ineligibility_reasons",
        "semantic_response_count",
        "semantic_per_response_sum",
        "cumulative",
        "reconciliation"
      ],
      "properties": {
        "status": {
          "enum": ["normalized", "not_observable"]
        },
        "rule_id": {
          "type": ["string", "null"]
        },
        "eligible_for_normalization": {
          "type": "boolean"
        },
        "ineligibility_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "semantic_response_count": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_per_response_sum": {
          "$ref": "#/$defs/token_counters"
        },
        "semantic_request_sum": {
          "$ref": "#/$defs/claude_native_counters"
        },
        "cumulative": {
          "$ref": "#/$defs/token_counters"
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "fields"],
          "properties": {
            "status": {
              "enum": ["reconciled", "divergent", "not_observable"]
            },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_tokens",
                "cached_input_tokens",
                "cache_write_input_tokens",
                "output_tokens",
                "reasoning_output_tokens",
                "total_tokens"
              ],
              "properties": {
                "input_tokens": { "$ref": "#/$defs/field_reconciliation" },
                "cached_input_tokens": { "$ref": "#/$defs/field_reconciliation" },
                "cache_write_input_tokens": { "$ref": "#/$defs/field_reconciliation" },
                "output_tokens": { "$ref": "#/$defs/field_reconciliation" },
                "reasoning_output_tokens": { "$ref": "#/$defs/field_reconciliation" },
                "total_tokens": { "$ref": "#/$defs/field_reconciliation" }
              }
            }
          }
        }
      }
    },
    "context_compaction_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger",
          "pre_tokens",
          "post_tokens",
          "cumulative_dropped_tokens",
          "duration_ms",
          "preserved_messages_count"
        ],
        "properties": {
          "trigger": { "type": ["string", "null"] },
          "pre_tokens": { "$ref": "#/$defs/counter_value" },
          "post_tokens": { "$ref": "#/$defs/counter_value" },
          "cumulative_dropped_tokens": { "$ref": "#/$defs/counter_value" },
          "duration_ms": {
            "oneOf": [
              { "type": "number", "minimum": 0 },
              { "const": "not_observable" }
            ]
          },
          "preserved_messages_count": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              { "const": "not_observable" }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "claude_native_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "thinking_tokens"
      ],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/counter_value" },
        "output_tokens": { "$ref": "#/$defs/counter_value" },
        "cache_creation_input_tokens": { "$ref": "#/$defs/counter_value" },
        "cache_read_input_tokens": { "$ref": "#/$defs/counter_value" },
        "thinking_tokens": { "$ref": "#/$defs/counter_value" }
      }
    },
    "token_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/counter_value" },
        "cached_input_tokens": { "$ref": "#/$defs/counter_value" },
        "cache_write_input_tokens": { "$ref": "#/$defs/counter_value" },
        "output_tokens": { "$ref": "#/$defs/counter_value" },
        "reasoning_output_tokens": { "$ref": "#/$defs/counter_value" },
        "total_tokens": { "$ref": "#/$defs/counter_value" }
      }
    },
    "counter_value": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "const": "not_observable" }
      ]
    },
    "field_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cumulative_value", "per_response_value"],
      "properties": {
        "status": {
          "enum": ["reconciled", "divergent", "not_observable"]
        },
        "cumulative_value": { "$ref": "#/$defs/counter_value" },
        "per_response_value": { "$ref": "#/$defs/counter_value" },
        "delta": {
          "type": ["integer", "null"]
        }
      }
    },
    "derived_metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "derivation_id"],
          "properties": {
            "value": { "type": "number" },
            "derivation_id": { "type": "string", "minLength": 1 }
          }
        },
        { "const": "not_observable" }
      ]
    }
  }
}
