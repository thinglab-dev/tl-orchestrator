   359	def _relative(root: Path, target: Path) -> str:
   360	    return target.relative_to(root).as_posix()
   361	
   362	
   363	def _entry_for(root: Path, target: Path) -> dict[str, Any]:
   364	    """One snapshot entry: path, type, size, sha256. A symlink is hashed by its target text."""
   365	    relative = _relative(root, target)
   366	    if target.is_symlink():
   367	        link = os.readlink(target).encode("utf-8")
   368	        return {"path": relative, "type": "symlink", "size": len(link), "sha256": sha256_hex(link)}
   369	    data = target.read_bytes()
   370	    return {"path": relative, "type": "file", "size": len(data), "sha256": sha256_hex(data)}
   371	
   372	
   373	def snapshot_set(root: str | Path, pattern: str) -> dict[str, Any]:
   374	    """Reference snapshot of everything under `pattern`, stably ordered and digest-bound."""
   375	    root = Path(root).resolve()
   376	    target = root / pattern
   377	    entries: list[dict[str, Any]] = []
   378	    if target.is_symlink() or target.is_file():
   379	        entries.append(_entry_for(root, target))
   380	    elif target.is_dir():
   381	        for current, directories, files in os.walk(target, followlinks=False):
   382	            here = Path(current)
   383	            linked = [name for name in directories if (here / name).is_symlink()]
   384	            for name in files + linked:
   385	                entries.append(_entry_for(root, here / name))
   386	            # A symlinked directory is an entry in its own right, never a tree to descend into.
   387	            directories[:] = sorted(name for name in directories if name not in linked)
   388	    entries.sort(key=lambda item: item["path"])
   389	    return {"pattern": Path(pattern).as_posix(), "entries": entries, "digest": digest_of(entries)}
