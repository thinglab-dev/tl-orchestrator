  1472	        max_calls = int(budget.get("max_model_calls", 0))
  1473	        if max_calls and self.model_calls_consumed() + needed_calls > max_calls:
  1474	            reason = "insufficient_budget_for_unit_verification" if needed_calls > 1 else "model_call_budget_exhausted"
  1475	            raise StopBatch(reason, f"{self.model_calls_consumed()} consumed + {needed_calls} needed > {max_calls}")
