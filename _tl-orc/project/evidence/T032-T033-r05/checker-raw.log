diff --git a/schemas/story-child-proposal.schema.json b/schemas/story-child-proposal.schema.json
new file mode 100644
index 0000000..f38d542
--- /dev/null
+++ b/schemas/story-child-proposal.schema.json
@@ -0,0 +1,222 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "tl-orchestrator Story Child Batch Proposal",
+  "description": "T032: a child batch derived by the runtime under an already authorized Story Authority. It carries no human signature of its own: its authority is proven by verify_derivation() against the root envelope. The proposal is the digested object, so it never contains the derivation proof that digests it.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema_version",
+    "child_batch_id",
+    "authority_id",
+    "parent_child_batch_id",
+    "work_ref",
+    "authorized_spec_revision",
+    "authorized_spec_sha256",
+    "required_mutation_targets",
+    "conditional_mutation_targets",
+    "forbidden_paths",
+    "protected_paths",
+    "allowed_effects",
+    "model_call_budget",
+    "functional_parent_checkpoint",
+    "derived_from_action_items",
+    "lineage"
+  ],
+  "properties": {
+    "schema_version": {
+      "const": 1
+    },
+    "child_batch_id": {
+      "type": "string",
+      "pattern": "^B[0-9]{3,}$"
+    },
+    "authority_id": {
+      "type": "string",
+      "pattern": "^A[0-9]{3,}$"
+    },
+    "parent_child_batch_id": {
+      "type": [
+        "string",
+        "null"
