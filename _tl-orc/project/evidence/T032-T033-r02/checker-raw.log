   544	def gate_call_constraints_are_satisfiable_under_budget(plan: dict) -> list[dict]:
   545	    """Arithmetic proof that every declared scenario fits under the plan's model call budget.
   546	
   547	    A plan that only adds up on the happy path is a plan that stops mid-review the first time
   548	    the Maker needs a second round, so both the straight-line and the retry scenario must be
   549	    declared and both must be shown to fit.
   550	    """
   551	    findings: list[dict] = []
   552	    budget = plan.get("budget") or {}
   553	    ceiling = int(budget.get("max_model_calls", 0))
   554	    bootstrap = int(budget.get("bootstrap_calls", 0))
   555	    per_round = budget.get("role_calls_per_round") or {}
   556	    round_cost = sum(int(value) for value in per_round.values())
   557	    gate_cost = sum(int(gate.get("model_calls", 0)) for gate in plan.get("gates") or [])
   558	    scenarios = plan.get("scenarios") or []
   559	    declared = {str(scenario.get("name")) for scenario in scenarios}
   560	    if len(declared) != len(scenarios):
   561	        findings.append({"violation": "duplicate_budget_scenario",
   562	                         "detail": "scenario names within scenarios array must be unique"})
   563	    for name in REQUIRED_BUDGET_SCENARIOS:
   564	        if name not in declared:
   565	            findings.append({"violation": "missing_budget_scenario", "scenario": name,
   566	                             "detail": "satisfiability must be proven for the straight-line and the retry scenario"})
   567	    for scenario in scenarios:
   568	        name = str(scenario.get("name"))
   569	        rounds = int(scenario.get("rework_rounds", 0))
   570	        if name == "straight_line" and rounds != 0:
   571	            findings.append({"violation": "invalid_budget_scenario_rounds", "scenario": "straight_line",
   572	                             "rework_rounds": rounds, "detail": "straight_line scenario must specify rework_rounds == 0"})
   573	        elif name == "retry" and rounds < 1:
   574	            findings.append({"violation": "invalid_budget_scenario_rounds", "scenario": "retry",
   575	                             "rework_rounds": rounds, "detail": "retry scenario must specify at least 1 rework round (rework_rounds >= 1)"})
   576	        required = bootstrap + (1 + rounds) * round_cost + gate_cost
   577	        if required > ceiling:
   578	            findings.append({"violation": "gate_call_constraints_unsatisfiable", "scenario": scenario.get("name"),
   579	                             "required_calls": required, "max_model_calls": ceiling,
   580	                             "detail": f"{bootstrap} bootstrap + {1 + rounds} round(s) x {round_cost} + {gate_cost} gate call(s)"})
   581	    return findings
