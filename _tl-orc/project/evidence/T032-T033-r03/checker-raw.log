   427	def verify_protected_paths(root: str | Path, protected_paths: list[dict], *, dirty_paths: list[str] | None = None) -> list[dict]:
   428	    """Verify each protected path against the tree. Returns structured violations (empty = intact)."""
   429	    root = Path(root).resolve()
   430	    violations: list[dict] = []
   431	    read_only = [item for item in protected_paths if item.get("policy") == "read_only"]
   432	    if read_only:
   433	        dirty = dirty_paths if dirty_paths is not None else _git_dirty_paths(root)
   434	        for item in read_only:
   435	            pattern = str(item.get("pattern", ""))
   436	            if dirty is None:
   437	                violations.append({"pattern": pattern, "policy": "read_only",
   438	                                   "violation": "protected_read_only_unverifiable",
   439	                                   "detail": "no baseline was supplied and git could not report the working tree"})
   440	                continue
   441	            for path in [p for p in dirty if _covers(pattern, p)]:
   442	                violations.append({"pattern": pattern, "policy": "read_only",
   443	                                   "violation": "protected_read_only_mutated", "path": path})
   444	
   445	    for item in protected_paths:
   446	        policy = item.get("policy")
   447	        pattern = str(item.get("pattern", ""))
   448	        target = root / pattern
   449	        if policy == "exact_file_hash":
   450	            expected = str(item.get("sha256", ""))
   451	            if target.is_symlink():
   452	                violations.append({"pattern": pattern, "policy": policy, "path": pattern,
   453	                                   "violation": "protected_file_type_changed",
   454	                                   "expected": "file", "observed": "symlink"})
   455	                continue
   456	            if not target.is_file():
   457	                violations.append({"pattern": pattern, "policy": policy, "path": pattern,
   458	                                   "violation": "protected_path_missing"})
   459	                continue
   460	            observed = sha256_hex(target.read_bytes())
   461	            if observed != expected:
   462	                violations.append({"pattern": pattern, "policy": policy, "path": pattern,
   463	                                   "violation": "protected_file_hash_mismatch",
   464	                                   "expected": expected, "observed": observed})
   465	        elif policy == "exact_set_snapshot":
   466	            reference = item.get("snapshot") or {}
   467	            declared_entries = [e for e in reference.get("entries", []) if isinstance(e, dict) and "path" in e]
   468	            expected_entries = {entry["path"]: entry for entry in declared_entries}
   469	            observed_entries = {entry["path"]: entry for entry in snapshot_set(root, pattern)["entries"]}
   470	            for path in sorted(set(observed_entries) - set(expected_entries)):
   471	                violations.append({"pattern": pattern, "policy": policy, "path": path,
   472	                                   "violation": "protected_set_entry_added",
   473	                                   "observed": observed_entries[path]})
   474	            for path in sorted(set(expected_entries) - set(observed_entries)):
   475	                violations.append({"pattern": pattern, "policy": policy, "path": path,
   476	                                   "violation": "protected_set_entry_removed",
   477	                                   "expected": expected_entries[path]})
   478	            for path in sorted(set(expected_entries) & set(observed_entries)):
   479	                expected_entry, observed_entry = expected_entries[path], observed_entries[path]
   480	                if expected_entry.get("type") != observed_entry.get("type"):
   481	                    violations.append({"pattern": pattern, "policy": policy, "path": path,
   482	                                       "violation": "protected_set_entry_type_changed",
   483	                                       "expected": expected_entry.get("type"), "observed": observed_entry.get("type")})
   484	                elif (expected_entry.get("sha256") != observed_entry.get("sha256")
   485	                      or expected_entry.get("size") != observed_entry.get("size")):
   486	                    violations.append({"pattern": pattern, "policy": policy, "path": path,
   487	                                       "violation": "protected_set_entry_modified",
   488	                                       "expected": expected_entry, "observed": observed_entry})
   489	            declared_digest = reference.get("digest")
   490	            recomputed = digest_of(declared_entries)
   491	            if declared_digest and declared_digest != recomputed:
   492	                violations.append({"pattern": pattern, "policy": policy,
   493	                                   "violation": "protected_snapshot_digest_mismatch",
   494	                                   "expected": declared_digest, "observed": recomputed})
   495	    return violations
