   116	    def test_global_budget_stops_the_batch_before_the_child_ledger_would(self) -> None:
   117	        """The child allocation is generous; the Story ceiling is what actually binds."""
   118	        fx = self.auto_story_fixture(budget=8, max_calls=8)
   119	        # Another child under the same authority has already spent seven of the eight calls.
   120	        with self.authority(fx) as spender:
   121	            for index in range(7):
   122	                story.budgeted_authority_dispatch(
   123	                    spender, child_batch_id="B000", logical_call_id=f"B000-call-{index}", role="maker",
   124	                    phase="implementation", dispatch=lambda _a: {"state": "completed"})
   125	            self.assertEqual(spender.remaining_global_budget, 1)
   126	
   127	        fx.script("maker", MAKER_OK)
   128	        fx.script("checker", CHECKER_OK)
   129	        state = fx.runtime().run()
   130	        self.assertEqual(state, "stopped")
   131	        fold = fx.fold()
   132	        # The child ledger still shows an allocation of eight; one global call cannot cover Maker
   133	        # plus an independent Checker, so the Story ceiling is what stops the batch.
   134	        self.assertEqual(fold.stop_reason, "insufficient_budget_for_unit_verification")
   135	        self.assertIn("story authority A001", json.dumps(fx.journal()))
   136	        self.assertEqual(fold.model_calls_done, 0)
   137	        authority = self.authority(fx)
   138	        authority.state = authority.journal.fold()
   139	        self.assertEqual(authority.state.consumed_calls, 7)
   140	        self.assertEqual(authority.child_budget_projection("B001")["consumed_model_calls"], 0)
