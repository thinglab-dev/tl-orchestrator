   584	def validate_execution_plan(
   585	    plan: Any,
   586	    *,
   587	    repo_root: str | Path | None = None,
   588	    parent_protected_paths: list[dict] | None = None,
   589	    verify_paths: bool = False,
   590	    schema_path: str | Path | None = None,
   591	) -> dict:
   592	    """Validate one execution plan. Fail-closed: any doubt is a refusal, never a warning."""
   593	    errors: list[dict] = []
   594	    schema_file = Path(schema_path) if schema_path else SCHEMA_DIR / "execution-plan.schema.json"
   595	    valid, schema_errors = validate_against_schema_file(plan, schema_file)
   596	    if not valid:
   597	        return {"approved": False,
   598	                "errors": [{"violation": "schema_invalid", "detail": message} for message in schema_errors]}
   599	
   600	    seen_gates: set[str] = set()
   601	    for gate in plan["gates"]:
   602	        gate_id = str(gate["gate_id"])
   603	        if gate_id in seen_gates:
   604	            errors.append({"violation": "duplicate_gate_id", "gate_id": gate_id})
   605	        seen_gates.add(gate_id)
   606	        phase = str(gate["lifecycle_phase"])
   607	        if phase not in LIFECYCLE_PHASES:
   608	            errors.append({"violation": "unknown_lifecycle_phase", "gate_id": gate_id, "lifecycle_phase": phase})
   609	            continue
   610	        for assertion in gate["assertions"]:
   611	            assertion_id = str(assertion["assertion_id"])
   612	            spec = ASSERTION_REGISTRY.get(assertion_id)
   613	            if spec is None:
   614	                errors.append({"violation": "unknown_assertion", "gate_id": gate_id, "assertion_id": assertion_id,
   615	                               "detail": "assertion is not in the closed registry"})
   616	                continue
   617	            if phase not in spec["phases"]:
   618	                errors.append({"violation": "assertion_phase_mismatch", "gate_id": gate_id,
   619	                               "assertion_id": assertion_id, "lifecycle_phase": phase,
   620	                               "allowed_phases": list(spec["phases"])})
   621	            parameters = assertion.get("parameters") or {}
   622	            for name in spec["required"]:
   623	                if name not in parameters:
   624	                    errors.append({"violation": "assertion_parameter_missing", "gate_id": gate_id,
   625	                                   "assertion_id": assertion_id, "parameter": name})
   626	            for name, value in parameters.items():
   627	                declared = spec["parameters"].get(name)
   628	                if declared is None:
   629	                    errors.append({"violation": "assertion_parameter_unknown", "gate_id": gate_id,
   630	                                   "assertion_id": assertion_id, "parameter": name})
   631	                    continue
   632	                for message in validate_json_schema(value, declared, declared, f"{gate_id}.{assertion_id}.{name}"):
   633	                    errors.append({"violation": "assertion_parameter_invalid", "gate_id": gate_id,
   634	                                   "assertion_id": assertion_id, "parameter": name, "detail": message})
   635	
   636	    errors.extend(gate_call_constraints_are_satisfiable_under_budget(plan))
   637	
   638	    protected = plan.get("protected_paths") or []
   639	    for item in protected:
   640	        if item.get("policy") == "exact_file_hash" and not item.get("sha256"):
   641	            errors.append({"violation": "protected_path_missing_hash", "pattern": item.get("pattern")})
   642	        if item.get("policy") == "exact_set_snapshot" and not isinstance((item.get("snapshot") or {}).get("entries"), list):
   643	            errors.append({"violation": "protected_path_missing_snapshot", "pattern": item.get("pattern")})
   644	    if parent_protected_paths is not None:
   645	        errors.extend(assert_protected_paths_monotonic(parent_protected_paths, protected))
   646	    if verify_paths:
   647	        if repo_root is None:
   648	            errors.append({"violation": "protected_paths_unverifiable",
   649	                           "detail": "a repository root is required to verify protected paths"})
   650	        else:
   651	            errors.extend(verify_protected_paths(repo_root, protected))
   652	
   653	    return {"approved": not errors, "errors": errors, "plan_id": plan.get("plan_id"),
   654	            "plan_digest": digest_of(plan), "assertions_registered": sorted(ASSERTION_REGISTRY)}
   655	
   656	
   657	def main(argv: list[str] | None = None) -> int:
   658	    parser = argparse.ArgumentParser(description="Validate an execution plan and its protected paths (T033).")
   659	    parser.add_argument("--plan", type=Path)
   660	    parser.add_argument("--repo", type=Path, help="repository root used to verify protected paths")
   661	    parser.add_argument("--parent-plan", type=Path, help="parent plan whose protected paths must be inherited or tightened")
   662	    parser.add_argument("--verify-protected-paths", action="store_true")
   663	    parser.add_argument("--schema", type=Path)
   664	    parser.add_argument("--output", type=Path)
   665	    parser.add_argument("--print-registry", action="store_true", help="print the closed assertion registry and exit")
   666	    args = parser.parse_args(argv)
   667	
   668	    if args.print_registry:
   669	        print(json.dumps({"lifecycle_phases": list(LIFECYCLE_PHASES),
   670	                          "assertions": {name: {"phases": list(spec["phases"]), "required": list(spec["required"]),
   671	                                                "description": spec["description"]}
   672	                                         for name, spec in sorted(ASSERTION_REGISTRY.items())}},
   673	                         indent=2, ensure_ascii=False))
   674	        return 0
   675	    if args.plan is None:
   676	        parser.error("--plan is required unless --print-registry is used")
   677	
   678	    result: dict
   679	    try:
   680	        plan = json.loads(args.plan.read_text(encoding="utf-8"))
   681	    except (OSError, ValueError) as exc:
   682	        result = {"approved": False, "errors": [{"violation": "plan_unreadable", "detail": str(exc)}]}
   683	    else:
   684	        parent_paths = None
   685	        blocked = False
   686	        if args.parent_plan:
   687	            try:
   688	                parent = json.loads(args.parent_plan.read_text(encoding="utf-8"))
   689	            except (OSError, ValueError) as exc:
   690	                result = {"approved": False, "errors": [{"violation": "parent_plan_unreadable", "detail": str(exc)}]}
   691	                blocked = True
   692	            else:
   693	                parent_paths = (parent or {}).get("protected_paths") or []
   694	        if not blocked:
   695	            result = validate_execution_plan(plan, repo_root=args.repo, parent_protected_paths=parent_paths,
   696	                                             verify_paths=args.verify_protected_paths, schema_path=args.schema)
   697	    payload = json.dumps(result, indent=2, ensure_ascii=False)
   698	    if args.output:
   699	        args.output.parent.mkdir(parents=True, exist_ok=True)
   700	        args.output.write_text(payload + "\n", encoding="utf-8")
   701	    print(payload)
   702	    return 0 if result.get("approved") else 1
   703	
   704	
   705	if __name__ == "__main__":
   706	    sys.exit(main())
