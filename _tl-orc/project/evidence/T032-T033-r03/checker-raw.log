  1097	def _scope_paths(scope: dict) -> list[str]:
  1098	    return list(scope.get("required_mutation_targets") or []) + list(scope.get("conditional_mutation_targets") or [])
  1099	
  1100	
  1101	def _within(path: str, scopes: Iterable[str]) -> bool:
  1102	    normalized = Path(str(path)).as_posix().strip("/")
  1103	    for scope in scopes:
  1104	        candidate = Path(str(scope)).as_posix().strip("/")
  1105	        if candidate in {"", "."} or normalized == candidate or normalized.startswith(candidate + "/"):
  1106	            return True
  1107	    return False
  1108	
  1109	
  1110	within_scope = _within
  1111	
  1112	
  1113	def _item_locations(item: dict) -> list[str]:
  1114	    """Paths an action item points at. A location that names no path cannot be proven in scope."""
  1115	    raw = str(item.get("location", ""))
  1116	    parts = [chunk.strip() for chunk in re.split(r"[,;\s]+", raw) if chunk.strip()]
  1117	    locations = []
  1118	    for part in parts:
  1119	        path = part.split(":", 1)[0].strip()
  1120	        if path and ("/" in path or "." in path):
  1121	            locations.append(Path(path).as_posix())
  1122	    return locations
  1123	
  1124	
  1125	def classify_action_item(item: dict, payload: dict, spec_paths: Iterable[str] = ()) -> dict:
  1126	    """Compute scope_status and spec_status mechanically, and refuse a contradicting declaration."""
  1127	    scope = payload["authorized_write_scope"]
  1128	    authorized = _scope_paths(scope)
  1129	    forbidden = list(scope.get("forbidden_paths") or [])
  1130	    protected = [str(p.get("pattern", "")) for p in payload.get("protected_paths") or []]
  1131	    locations = _item_locations(item)
  1132	    if not locations:
  1133	        scope_status = "unprovable"
  1134	    elif any(_within(path, forbidden) or _within(path, protected) for path in locations):
  1135	        scope_status = "outside_parent_envelope"
  1136	    elif all(_within(path, authorized) for path in locations):
  1137	        scope_status = "inside_parent_envelope"
  1138	    else:
  1139	        scope_status = "outside_parent_envelope"
  1140	    spec_status = "changed" if locations and any(_within(path, spec_paths) for path in locations) else "unchanged"
  1141	    if str(item.get("category", "")) == "bad_spec":
  1142	        spec_status = "changed"  # the finding is about the specification itself, by construction
  1143	    computed = {"scope_status": scope_status, "spec_status": spec_status, "locations": locations}
  1144	    for name in ("scope_status", "spec_status"):
  1145	        declared = item.get(name)
  1146	        if declared is not None and str(declared) != computed[name]:
  1147	            computed["conflict"] = (
  1148	                f"the Checker declared {name}={declared!r} but the envelope proves {computed[name]!r}")
  1149	    return computed
  1150	
  1151	
  1152	def derivation_eligibility(action_items: list[dict], payload: dict, spec_paths: Iterable[str] = ()) -> tuple[bool, list[dict]]:
  1153	    """A child batch is derivable only when every residual finding is strictly patch-only."""
  1154	    blockers: list[dict] = []
  1155	    if not action_items:
  1156	        blockers.append({"reason": "intent_gap", "detail": "no residual action item to derive a child batch from"})
  1157	        return False, blockers
  1158	    for item in action_items:
  1159	        item_id = str(item.get("id", "?"))
  1160	        category = str(item.get("category", ""))
  1161	        target_role = str(item.get("target_role", ""))
  1162	        if category in DERIVATION_HARD_STOP_REASONS and category != PATCH_ONLY_CATEGORY:
  1163	            blockers.append({"reason": category, "item": item_id,
  1164	                             "detail": f"category {category!r} requires a human decision"})
  1165	            continue
  1166	        if category != PATCH_ONLY_CATEGORY:
  1167	            blockers.append({"reason": "intent_gap", "item": item_id,
  1168	                             "detail": f"category must be {PATCH_ONLY_CATEGORY!r}, got {category!r}"})
  1169	            continue
  1170	        if target_role != PATCH_ONLY_TARGET_ROLE:
  1171	            blockers.append({"reason": "human" if target_role == "human" else "bad_spec", "item": item_id,
  1172	                             "detail": f"target_role must be {PATCH_ONLY_TARGET_ROLE!r}, got {target_role!r}"})
  1173	            continue
  1174	        for flag in item.get("derivation_blockers") or []:
  1175	            blockers.append({"reason": str(flag), "item": item_id,
  1176	                             "detail": f"the Checker flagged {flag!r} on this item"})
  1177	        computed = classify_action_item(item, payload, spec_paths)
  1178	        if "conflict" in computed:
  1179	            blockers.append({"reason": "state_integrity", "item": item_id, "detail": computed["conflict"]})
  1180	        if computed["scope_status"] != PATCH_ONLY_SCOPE_STATUS:
  1181	            blockers.append({"reason": "scope_expansion", "item": item_id,
  1182	                             "detail": f"scope_status is {computed['scope_status']!r} for {computed['locations']}"})
  1183	        if computed["spec_status"] != PATCH_ONLY_SPEC_STATUS:
  1184	            blockers.append({"reason": "bad_spec", "item": item_id,
  1185	                             "detail": f"spec_status is {computed['spec_status']!r}"})
  1186	    return not blockers, blockers
  1187	
