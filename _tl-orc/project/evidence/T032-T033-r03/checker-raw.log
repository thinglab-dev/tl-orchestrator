   565	        self.authority_id = self.payload["authority_id"]
   566	        self.root_digest = self.envelope["root_authority_digest"]
   567	        self.runtime_dir = Path(runtime_dir)
   568	        self.repo = Path(repo) if repo is not None else None
   569	        self.journal = AuthorityJournal(self.runtime_dir / "journal.jsonl")
   570	        self._lease = None
   571	        self.state = AuthorityState()
   572	
   573	    # ---- construction helpers ----------------------------------------------------------
   574	
   575	    @classmethod
   576	    def open_for(cls, repo: str | Path, authority_id: str) -> "StoryAuthority":
   577	        repo = Path(repo)
   578	        envelope = load_authority(authority_envelope_path(repo, authority_id))
   579	        return cls(envelope, repo / RUNTIME_AUTHORITY_DIR / authority_id, repo=repo)
   580	
   581	    # ---- lease and journal -------------------------------------------------------------
   582	
   583	    def acquire(self) -> "StoryAuthority":
   584	        if self._lease is not None:
   585	            return self
   586	        self.runtime_dir.mkdir(parents=True, exist_ok=True)
   587	        handle = open(self.runtime_dir / "lease.lock", "a+", encoding="utf-8")
   588	        if not _lock_exclusive(handle):
   589	            handle.close()
   590	            raise Refusal(
   591	                f"coordinator_conflict: another runtime holds the lease for story authority {self.authority_id}", 5)
   592	        self._lease = handle
   593	        self.refold()
   594	        if self.state.invalid_lines:
   595	            raise HardStop(
   596	                "state_integrity",
   597	                f"authority journal has {self.state.invalid_lines} invalid line(s); the hash chain is broken",
   598	                authority_id=self.authority_id)
   599	        if not self.state.opened:
   600	            self.journal.append(
   601	                "authority_open", authority_id=self.authority_id, work_ref=self.payload["work_ref"],
   602	                root_authority_digest=self.root_digest,
   603	                global_model_call_budget=self.payload["global_model_call_budget"],
   604	                max_child_batches=self.payload["max_child_batches"],
   605	                max_consecutive_failed_batches=self.payload["max_consecutive_failed_batches"],
   606	                wall_clock_deadline=self.payload["wall_clock_deadline"],
   607	                authorized_at=self.envelope["operator_authorization"]["authorized_at"])
   608	            self.refold()
   609	        self.write_status()
   610	        return self
   611	
   612	    def release(self) -> None:
   613	        if self._lease is not None:
   614	            _unlock_exclusive(self._lease)
   615	            self._lease.close()
   616	            self._lease = None
   617	
   618	    def __enter__(self) -> "StoryAuthority":
   619	        return self.acquire()
   620	
   621	    def __exit__(self, *_exc: object) -> None:
   622	        self.release()
   623	
   624	    def refold(self) -> AuthorityState:
   625	        self.state = self.journal.fold()
   626	        return self.state
   627	
   628	    def _require_lease(self) -> None:
   629	        if self._lease is None:
   630	            raise Refusal(
   631	                "coordinator_conflict: the story authority lease must be held before reserving or deriving", 5)
   632	
   633	    def _require_open(self) -> None:
   634	        self.refold()
   635	        if self.state.closed:
   636	            raise HardStop(
   637	                "authority_missing_or_ambiguous",
   638	                f"story authority {self.authority_id} is closed ({self.state.close_state}: {self.state.close_reason})")
   639	
   640	    # ---- global budget -----------------------------------------------------------------
   641	
   642	    @property
   643	    def budget(self) -> int:
   644	        return int(self.payload["global_model_call_budget"])
   645	
   646	    @property
   647	    def remaining_global_budget(self) -> int:
   648	        return self.state.remaining(self.budget)
   649	
   650	    def assert_budget_covers(self, requested_calls: int) -> None:
   651	        if requested_calls < 0:
   652	            raise Refusal("requested_calls must not be negative")
   653	        if self.remaining_global_budget < requested_calls:
   654	            reason = "insufficient_budget_for_unit_verification" if requested_calls > 1 else "model_call_budget_exhausted"
   655	            raise HardStop(
   656	                reason,
   657	                f"{self.state.consumed_calls} consumed + {self.state.open_reservations} reserved + "
   658	                f"{requested_calls} requested > {self.budget}",
   659	                authority_id=self.authority_id, remaining=self.remaining_global_budget)
   660	
   661	    def next_global_attempt_id(self, logical_call_id: str = "") -> str:
   662	        """A fresh id per physical attempt. A retry never reuses the id of an earlier attempt."""
   663	        self.refold()
   664	        used = {int(match.group(1)) for match in
   665	                (re.match(rf"^{re.escape(self.authority_id)}-attempt-(\d+)$", a) for a in self.state.attempts) if match}
   666	        return f"{self.authority_id}-attempt-{max(used) + 1 if used else 1:03d}"
   667	
   668	    def reserve_call(
   669	        self,
   670	        *,
   671	        logical_call_id: str,
   672	        global_attempt_id: str,
   673	        child_batch_id: str,
   674	        role: str = "",
   675	        phase: str = "",
   676	        payload_digest: str = "",
   677	        requested_calls: int = 1,
   678	    ) -> dict:
   679	        """Write-ahead reservation under the lease. Idempotent for an identical replayed attempt."""
   680	        self._require_lease()
   681	        self._require_open()
   682	        existing = self.state.attempts.get(global_attempt_id)
   683	        if existing is not None:
   684	            same = (existing.get("logical_call_id") == logical_call_id
   685	                    and existing.get("child_batch_id") == child_batch_id
   686	                    and existing.get("payload_digest") == payload_digest)
   687	            if existing["state"] == "reserved" and same:
   688	                return existing  # crash between reservation and dispatch: the slot is already held
   689	            raise Refusal(
   690	                f"global_attempt_id_reuse: {global_attempt_id} is already {existing['state']}; "
   691	                "a retry must mint a new global_attempt_id", 2)
   692	        self.assert_budget_covers(max(1, int(requested_calls)))
   693	        self.journal.append(
   694	            "model_call_reserved", authority_id=self.authority_id, global_attempt_id=global_attempt_id,
   695	            logical_call_id=logical_call_id, child_batch_id=child_batch_id, role=role, phase=phase,
   696	            payload_digest=payload_digest)
   697	        self.refold()
   698	        self.write_status()
   699	        return self.state.attempts[global_attempt_id]
   700	
   701	    def consume_call(self, global_attempt_id: str, *, outcome: str = "consumed", receipt: dict | None = None) -> dict:
   702	        """Charge the attempt exactly once. Replaying a settled attempt never charges twice."""
   703	        self._require_lease()
   704	        if outcome not in {"consumed", "ambiguous"}:
   705	            raise Refusal(f"consume_call outcome must be 'consumed' or 'ambiguous', got {outcome!r}")
   706	        self.refold()
   707	        record = self.state.attempts.get(global_attempt_id)
   708	        if record is None:
   709	            raise Refusal(f"unknown global_attempt_id {global_attempt_id}: reserve before consuming", 2)
   710	        if record["state"] in CHARGED_ATTEMPT_STATES:
   711	            return record
   712	        if record["state"] == "released":
   713	            raise Refusal(
   714	                f"global_attempt_id {global_attempt_id} was released as proven pre-dispatch; it cannot be charged", 2)
   715	        self.journal.append(
   716	            "model_call_consumed", authority_id=self.authority_id, global_attempt_id=global_attempt_id,
   717	            logical_call_id=record.get("logical_call_id", ""), child_batch_id=record.get("child_batch_id", ""),
   718	            outcome=outcome, receipt=receipt or {})
   719	        self.refold()
   720	        self.write_status()
   721	        return self.state.attempts[global_attempt_id]
   722	
   723	    def release_call(self, global_attempt_id: str, *, proof: str) -> dict:
   724	        """Release a reservation only when it is proven the call never reached the provider."""
   725	        self._require_lease()
   726	        if not str(proof).strip():
   727	            raise Refusal("release_call requires the proof that the dispatch never started", 2)
   728	        self.refold()
   729	        record = self.state.attempts.get(global_attempt_id)
   730	        if record is None:
   731	            raise Refusal(f"unknown global_attempt_id {global_attempt_id}", 2)
   732	        if record["state"] == "released":
   733	            return record
   734	        if record["state"] in CHARGED_ATTEMPT_STATES:
   735	            raise Refusal(
   736	                f"global_attempt_id {global_attempt_id} is already {record['state']}; a charged call is never released", 2)
   737	        self.journal.append(
   738	            "model_call_released", authority_id=self.authority_id, global_attempt_id=global_attempt_id,
   739	            logical_call_id=record.get("logical_call_id", ""), child_batch_id=record.get("child_batch_id", ""),
   740	            outcome="released", proof=str(proof))
   741	        self.refold()
   742	        self.write_status()
   743	        return self.state.attempts[global_attempt_id]
