  1855	# --------------------------------------------------------------------------- budgeted dispatch bridge
  1856	
  1857	class AuthorityDispatchContext:
  1858	    """Duck-typed bridge handed to `tl_job.budgeted_model_dispatch`.
  1859	
  1860	    The authority journal is written first and settled last, so the child batch ledger can only
  1861	    ever be a projection of a charge that already exists globally. A crash between the two leaves
  1862	    a reservation that the authority still owns, never a call charged twice or charged nowhere.
  1863	    """
  1864	
  1865	    def __init__(self, authority: StoryAuthority, child_batch_id: str, logical_call_id: str,
  1866	                 global_attempt_id: str | None = None):
  1867	        self.authority = authority
  1868	        self.child_batch_id = child_batch_id
  1869	        self.logical_call_id = logical_call_id
  1870	        self.global_attempt_id = global_attempt_id or authority.next_global_attempt_id(logical_call_id)
  1871	
  1872	    def reserve(self, *, role: str = "", phase: str = "", payload_digest: str = "", requested_calls: int = 1) -> str:
  1873	        self.authority.reserve_call(
  1874	            logical_call_id=self.logical_call_id, global_attempt_id=self.global_attempt_id,
  1875	            child_batch_id=self.child_batch_id, role=role, phase=phase, payload_digest=payload_digest,
  1876	            requested_calls=requested_calls)
  1877	        return self.global_attempt_id
  1878	
  1879	    def consume(self, *, outcome: str = "consumed", receipt: dict | None = None) -> str:
  1880	        self.authority.consume_call(self.global_attempt_id, outcome=outcome, receipt=receipt)
  1881	        return self.global_attempt_id
  1882	
  1883	    def release(self, *, proof: str) -> str:
  1884	        self.authority.release_call(self.global_attempt_id, proof=proof)
  1885	        return self.global_attempt_id
  1886	
  1887	    def remaining(self) -> int:
  1888	        return self.authority.remaining_global_budget
  1889	
  1890	
  1891	def budgeted_authority_dispatch(
  1892	    authority: StoryAuthority,
  1893	    *,
  1894	    child_batch_id: str,
  1895	    logical_call_id: str,
  1896	    role: str,
  1897	    phase: str,
  1898	    dispatch: Callable[[str], dict],
  1899	    payload_digest: str = "",
  1900	    requested_calls: int = 1,
  1901	    global_attempt_id: str | None = None,
  1902	) -> dict:
  1903	    """Reserve globally, dispatch once, settle globally. The only path a model call may take.
  1904	
  1905	    `dispatch(global_attempt_id)` must return a record with `state`:
  1906	      - `released`  the transport proved nothing started; the slot is returned unspent
  1907	      - `ambiguous` the outcome cannot be proven; the slot is charged conservatively
  1908	      - anything else: the call happened and is charged.
  1909	    """
  1910	    context = AuthorityDispatchContext(authority, child_batch_id, logical_call_id, global_attempt_id)
  1911	    prior = authority.refold().attempts.get(context.global_attempt_id)
  1912	    if prior is not None and prior["state"] != "reserved":
  1913	        # Replaying a settled attempt after a crash re-reads the ledger; it never calls the provider
  1914	        # again and never moves the budget again.
  1915	        return {"global_attempt_id": context.global_attempt_id, "logical_call_id": logical_call_id,
  1916	                "child_batch_id": child_batch_id, "record": None, "replayed": True,
  1917	                "attempt_state": prior["state"], "remaining_global_budget": authority.remaining_global_budget}
  1918	    context.reserve(role=role, phase=phase, payload_digest=payload_digest, requested_calls=requested_calls)
  1919	    try:
  1920	        record = dispatch(context.global_attempt_id)
  1921	    except Exception as exc:  # the call may have reached the provider: never released on doubt
  1922	        context.consume(outcome="ambiguous", receipt={"error": str(exc)[:300]})
  1923	        raise
  1924	    state = str((record or {}).get("state", ""))
  1925	    if state == "released":
  1926	        context.release(proof=str((record or {}).get("proof") or "transport proved the dispatch never started"))
  1927	    elif state == "ambiguous":
  1928	        context.consume(outcome="ambiguous", receipt={"detail": str((record or {}).get("detail", ""))[:300]})
  1929	    else:
  1930	        context.consume(outcome="consumed", receipt={"state": state})
  1931	    return {"global_attempt_id": context.global_attempt_id, "logical_call_id": logical_call_id,
  1932	            "child_batch_id": child_batch_id, "record": record,
  1933	            "remaining_global_budget": authority.remaining_global_budget}
