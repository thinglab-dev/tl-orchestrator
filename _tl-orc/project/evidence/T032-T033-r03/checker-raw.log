  1008	    def close_authority(self, *, state: str = "done", reason: str = "") -> dict:
  1009	        self._require_lease()
  1010	        self.refold()
  1011	        if self.state.closed:
  1012	            return self.state.children  # already terminal; closing twice changes nothing
  1013	        event = self.journal.append("authority_closed", authority_id=self.authority_id, state=state, reason=reason)
  1014	        self.refold()
  1015	        self.write_status()
  1016	        return event
