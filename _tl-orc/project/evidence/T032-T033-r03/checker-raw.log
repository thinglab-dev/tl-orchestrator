   384	class AuthorityJournal:
   385	    """Append-only JSONL, one writer, write-ahead, fsynced, hash-chained."""
   386	
   387	    def __init__(self, path: Path):
   388	        self.path = Path(path)
   389	        self._seq = 0
   390	        self._prev = ""
