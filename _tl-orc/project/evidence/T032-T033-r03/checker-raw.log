  1063	def _lock_exclusive(handle) -> bool:
  1064	    if tl_job is not None:
  1065	        return bool(tl_job.lock_exclusive(handle))
  1066	    try:  # pragma: no cover - only when tl_job is unavailable
  1067	        import fcntl
  1068	
  1069	        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
  1070	        return True
  1071	    except (ImportError, OSError):
  1072	        return False
  1073	
  1074	
  1075	def _unlock_exclusive(handle) -> None:
  1076	    if tl_job is not None:
  1077	        tl_job.unlock_exclusive(handle)
  1078	        return
  1079	    with contextlib.suppress(ImportError, OSError, ValueError):  # pragma: no cover
  1080	        import fcntl
  1081	
  1082	        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
