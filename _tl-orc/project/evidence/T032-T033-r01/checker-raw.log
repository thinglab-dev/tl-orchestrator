  1438	    def _calls_needed(self, uid: str, round_no: int) -> int:
  1439	        """Model calls a round still has to make: a journaled ok Maker or Checker result is not charged again."""
  1440	        return sum(1 for role in ("maker", "checker")
  1441	                   if not any(k.startswith(f"{uid}:r{round_no}:{role}") and v.get("status") == "ok" for k, v in self.fold.steps.items()))
