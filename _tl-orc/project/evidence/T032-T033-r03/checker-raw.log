  1024	            "projection_of": "journal.jsonl",
  1025	            "authority_id": self.authority_id,
  1026	            "authority_mode": AUTHORITY_MODE,
  1027	            "work_ref": self.payload["work_ref"],
  1028	            "root_authority_digest": self.root_digest,
  1029	            "opened": state.opened,
  1030	            "closed": state.closed,
  1031	            "close_state": state.close_state,
  1032	            "close_reason": state.close_reason,
  1033	            "budget": {
  1034	                "global_model_call_budget": self.budget,
  1035	                "consumed_model_calls": state.consumed_calls,
  1036	                "reserved_model_calls": state.open_reservations,
  1037	                "released_model_calls": state.released_calls,
  1038	                "remaining_global_budget": self.remaining_global_budget,
  1039	            },
  1040	            "children": {
  1041	                cid: {
  1042	                    "state": child.get("state", ""),
  1043	                    "granted_model_calls": int((child.get("derivation") or {}).get("granted_model_calls", 0)),
  1044	                    "checker_verdict": (child.get("closure") or {}).get("checker_verdict", ""),
  1045	                    "checker_reviewed_commit": (child.get("closure") or {}).get("checker_reviewed_commit", ""),
  1046	                    "functional_checkpoint_commit": (child.get("closure") or {}).get("functional_checkpoint_commit", ""),
  1047	                    "budget": self.child_budget_projection(cid),
