  1750	# --------------------------------------------------------------------------- cognitive call barrier (§2.8)
  1751	
  1752	_POSIX_SHIM = """#!/bin/sh
  1753	printf '%s\\n' "{message} (blocked: {name})" 1>&2
  1754	exit {code}
  1755	"""
  1756	_WINDOWS_SHIM = """@echo off
  1757	1>&2 echo {message} (blocked: {name})
  1758	exit /b {code}
  1759	"""
  1760	
  1761	
  1762	def install_cognitive_barrier(directory: str | Path, *, names: Iterable[str] = COGNITIVE_CLIS) -> dict:
  1763	    """Write deterministic refusal shims that shadow every cognitive CLI on the worker PATH."""
  1764	    target = Path(directory)
  1765	    target.mkdir(parents=True, exist_ok=True)
  1766	    installed: list[str] = []
  1767	    for name in names:
  1768	        if os.name == "nt":
  1769	            shim = target / f"{name}.cmd"
  1770	            shim.write_text(_WINDOWS_SHIM.format(message=BARRIER_MESSAGE, name=name, code=BARRIER_EXIT_CODE),
  1771	                            encoding="utf-8", newline="\r\n")
  1772	        else:
  1773	            shim = target / name
  1774	            shim.write_text(_POSIX_SHIM.format(message=BARRIER_MESSAGE, name=name, code=BARRIER_EXIT_CODE),
  1775	                            encoding="utf-8", newline="\n")
  1776	            shim.chmod(shim.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
  1777	        installed.append(shim.name)
  1778	    return {"directory": target.as_posix(), "installed": sorted(installed), "exit_code": BARRIER_EXIT_CODE}
  1779	
  1780	
  1781	def barrier_path(directory: str | Path, base_path: str | None = None) -> str:
  1782	    """The barrier goes first, so a real CLI further down the PATH is never the one that resolves."""
  1783	    base = base_path if base_path is not None else os.environ.get("PATH", "")
  1784	    return os.pathsep.join([str(Path(directory)), base]) if base else str(Path(directory))
  1785	
  1786	
  1787	def barrier_worker_env(env: dict, directory: str | Path) -> dict:
  1788	    worker = dict(env)
  1789	    worker["PATH"] = barrier_path(directory, worker.get("PATH", ""))
  1790	    worker["TL_COGNITIVE_CALL_BARRIER"] = str(Path(directory))
  1791	    return worker
  1792	
  1793	
  1794	def probe_cognitive_barrier(directory: str | Path, *, names: Iterable[str] = COGNITIVE_CLIS,
  1795	                            env: dict | None = None) -> dict:
  1796	    """Prove mechanically that a direct invocation fails before it can reach any provider.
  1797	
  1798	    The probe runs in the environment the worker will actually get, resolves each name through that
  1799	    PATH, and executes what it finds. If the platform cannot make the barrier win PATH resolution,
  1800	    or the shim does not fail deterministically, the capability is `unavailable` and AUTO_STORY
  1801	    refuses to start. There is no degraded mode: a barrier that might not hold is not a barrier.
  1802	
  1803	    Known limitation, declared rather than papered over: the barrier shadows *name* resolution.
  1804	    A worker that already knows the absolute path of a real cognitive CLI can still execute it,
  1805	    which is why `budgeted_model_dispatch` remains the control-plane obligation and the barrier is
  1806	    a second line of defence, not the only one.
  1807	    """
  1808	    target = Path(directory)
  1809	    worker_env = dict(env) if env is not None else dict(os.environ)
  1810	    worker_env["PATH"] = barrier_path(target, worker_env.get("PATH", os.environ.get("PATH", "")))
  1811	    checks: list[dict] = []
  1812	    available = True
  1813	    for name in names:
  1814	        resolved = shutil.which(name, path=worker_env["PATH"])
  1815	        shadowed = bool(resolved) and Path(resolved).resolve().parent == target.resolve()
  1816	        record: dict[str, Any] = {"cli": name, "resolved": resolved or "", "shadows_real_cli": shadowed}
  1817	        if not shadowed:
  1818	            record["reason"] = "the barrier directory does not win PATH resolution for this name"
  1819	            available = False
  1820	            checks.append(record)
  1821	            continue
  1822	        try:
  1823	            run = subprocess.run([resolved], capture_output=True, text=True, check=False, timeout=30,
  1824	                                 env=worker_env)
  1825	            record["exit_code"] = run.returncode
  1826	            record["blocked"] = run.returncode == BARRIER_EXIT_CODE
  1827	            record["stderr"] = run.stderr.strip()[:200]
  1828	        except (OSError, subprocess.SubprocessError) as exc:
  1829	            # A shim that cannot be executed at all still refuses the call, but it refuses for a
  1830	            # reason the platform chose rather than one this barrier proved. That is not enough.
  1831	            record["blocked"] = False
  1832	            record["reason"] = f"the shim could not be executed: {exc}"
  1833	        if not record.get("blocked"):
  1834	            available = False
  1835	        checks.append(record)
  1836	    return {"capability": "available" if available else "unavailable", "barrier_directory": target.as_posix(),
  1837	            "expected_exit_code": BARRIER_EXIT_CODE, "checks": checks,
  1838	            "limitation": "name resolution only: an absolute path to a real cognitive CLI is not shadowed"}
  1839	
  1840	
  1841	def require_cognitive_barrier(directory: str | Path, *, names: Iterable[str] = COGNITIVE_CLIS,
  1842	                              env: dict | None = None) -> dict:
  1843	    """Install and prove the barrier, or refuse to initialize AUTO_STORY. Never degrade silently."""
  1844	    install_cognitive_barrier(directory, names=names)
  1845	    report = probe_cognitive_barrier(directory, names=names, env=env)
  1846	    if report["capability"] != "available":
  1847	        raise HardStop(
  1848	            "cognitive_call_barrier_unavailable",
  1849	            "this environment cannot mechanically block direct cognitive CLI invocation, so AUTO_STORY "
  1850	            "will not start: " + canonical_json(report["checks"]),
  1851	            report=report)
  1852	    return report
