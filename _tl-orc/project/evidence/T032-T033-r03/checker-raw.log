    94	    # ---- §2.12 one charge, two ledgers ---------------------------------------------------
    95	
    96	    def test_auto_story_batch_charges_the_story_budget_exactly_once_per_call(self) -> None:
    97	        fx = self.auto_story_fixture()
    98	        fx.script("maker", MAKER_OK)
    99	        fx.script("checker", CHECKER_OK)
   100	        state = fx.runtime().run()
   101	        self.assertEqual(state, "done", fx.state_dir)
   102	
   103	        fold = fx.fold()
   104	        self.assertEqual(fold.model_calls_done, 2)
   105	        authority = self.authority(fx)
   106	        authority.journal.fold()
   107	        authority.state = authority.journal.fold()
   108	        self.assertEqual(authority.state.consumed_calls, 2)
   109	        self.assertEqual(authority.remaining_global_budget, 6)
   110	        projection = authority.child_budget_projection("B001")
   111	        self.assertEqual(projection["consumed_model_calls"], 2)
   112	        # Every attempt the batch journal charged is an attempt the authority journal owns.
   113	        self.assertEqual(len(projection["global_attempt_ids"]), 2)
   114	        self.assertEqual(authority.state.closure_of("B001")["checker_verdict"], "approved")
