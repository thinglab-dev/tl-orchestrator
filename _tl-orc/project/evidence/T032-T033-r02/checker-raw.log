+      "minLength": 1
+    },
+    "work_ref": {
+      "type": "string",
+      "minLength": 1
+    },
+    "authority_id": {
+      "type": "string",
+      "pattern": "^A[0-9]{3,}$",
+      "description": "Story Authority this plan executes under; absent for a legacy single-batch plan."
+    },
+    "budget": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "max_model_calls",
+        "role_calls_per_round"
+      ],
+      "properties": {
+        "max_model_calls": {
+          "type": "integer",
+          "minimum": 1
+        },
+        "bootstrap_calls": {
+          "type": "integer",
+          "minimum": 0,
+          "description": "Cognitive calls consumed before the first Maker round (classification, planning)."
+        },
+        "role_calls_per_round": {
+          "type": "object",
+          "minProperties": 1,
+          "propertyNames": {
+            "enum": [
+              "classifier",
+              "planner",
+              "maker",
+              "checker",
+              "advisor",
+              "searcher"
+            ]
+          },
+          "additionalProperties": {
+            "type": "integer",
+            "minimum": 0
+          }
+        }
+      }
+    },
+    "scenarios": {
+      "type": "array",
+      "minItems": 2,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": [
+          "name",
+          "rework_rounds"
+        ],
+        "properties": {
+          "name": {
+            "type": "string",
+            "minLength": 1
+          },
+          "rework_rounds": {
+            "type": "integer",
+            "minimum": 0
+          },
+          "description": {
+            "type": "string"
+          }
+        }
+      }
+    },
+    "gates": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": [
+          "gate_id",
+          "lifecycle_phase",
+          "assertions"
+        ],
+        "properties": {
+          "gate_id": {
+            "type": "string",
+            "minLength": 1
+          },
+          "lifecycle_phase": {
+            "type": "string",
+            "enum": [
+              "pre_execution",
+              "post_maker_pre_review",
+              "post_checker_pre_merge",
+              "post_merge_pre_close",
+              "post_terminal"
+            ]
+          },
+          "model_calls": {
+            "type": "integer",
+            "minimum": 0
+          },
+          "assertions": {
+            "type": "array",
+            "minItems": 1,
+            "items": {
+              "type": "object",
+              "additionalProperties": false,
+              "required": [
+                "assertion_id"
+              ],
+              "properties": {
+                "assertion_id": {
+                  "type": "string",
+                  "pattern": "^[a-z][a-z0-9_]*$"
+                },
+                "parameters": {
+                  "type": "object"
+                }
+              }
+            }
+          }
+        }
+      }
+    },
+    "protected_paths": {
+      "type": "array",
+      "items": {
