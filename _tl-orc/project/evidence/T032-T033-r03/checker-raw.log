  2705	def command_budgeted_dispatch(args: argparse.Namespace, argv: list[str], max_bytes: int) -> int:
  2706	    cmd = argv
  2707	    if not cmd:
  2708	        raise JobError(EXIT_USAGE, "invalid_input", "budgeted-dispatch requires command after --")
  2709	    ok, reason, detail = budgeted_model_dispatch(
  2710	        batch_input=args.batch_file,
  2711	        role=args.role,
  2712	        phase=args.phase,
  2713	        call_id=args.call_id,
  2714	        harness_cmd=cmd,
  2715	        cwd=args.cwd,
  2716	        payload_digest=args.payload_digest,
  2717	    )
  2718	    result_payload = {
  2719	        "schema": SCHEMA_VERSION,
  2720	        "status": "ok" if ok else "failed",
  2721	        "reason": reason,
  2722	        "role": args.role,
  2723	        "phase": args.phase,
  2724	        "call_id": args.call_id,
  2725	    }
  2726	    if isinstance(detail, dict) and "exit_code" in detail:
  2727	        result_payload["exit_code"] = detail["exit_code"]
  2728	    emit(result_payload, max_bytes)
  2729	    return 0 if ok else 1
