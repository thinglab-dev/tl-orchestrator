   392	    def append(self, kind: str, **payload: Any) -> dict:
   393	        if kind not in JOURNAL_EVENTS:
   394	            raise Refusal(f"unknown authority journal event {kind!r}")
   395	        self._seq += 1
   396	        event = {"format_version": AUTHORITY_FORMAT, "seq": self._seq, "at": now_iso(), "kind": kind,
   397	                 "prev": self._prev, **payload}
   398	        line = canonical_json(event)
   399	        self._prev = sha256_hex(line)[:16]
   400	        self.path.parent.mkdir(parents=True, exist_ok=True)
   401	        with open(self.path, "a", encoding="utf-8", newline="\n") as handle:
   402	            handle.write(line + "\n")
   403	            handle.flush()
   404	            os.fsync(handle.fileno())
   405	        return event
   406	
   407	    def read(self) -> tuple[list[dict], int]:
   408	        events: list[dict] = []
   409	        invalid = 0
   410	        prev = ""
   411	        if not self.path.is_file():
   412	            return events, invalid
   413	        with open(self.path, "r", encoding="utf-8", errors="replace") as handle:
   414	            for raw in handle:
   415	                raw = raw.strip()
   416	                if not raw:
   417	                    continue
   418	                try:
   419	                    event = json.loads(raw)
