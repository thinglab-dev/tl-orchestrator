    29	class ProtectedPathVerificationTest(StoryCase):
    30	
    31	    def protected_docs(self) -> dict:
    32	        return {"pattern": "docs", "policy": "exact_set_snapshot", "snapshot": snapshot_set(self.root, "docs")}
    33	
    34	    def test_protected_paths_symlink_tampering(self) -> None:
    35	        """20. Replacing a regular file with a symlink is a violation, not an equivalent tree."""
    36	        if not can_symlink(self.root):
    37	            self.skipTest("this platform does not allow creating symlinks")
    38	        self.write("docs/NOTES.md", "operational notes\n")
    39	        reference = self.protected_docs()
    40	        self.assertEqual(verify(self.root, [reference]), [])
    41	
    42	        target = self.root / "docs" / "ARCH.md"
    43	        payload = target.read_bytes()
    44	        decoy = self.root / "docs" / ".arch-real.md"
    45	        decoy.write_bytes(payload)
    46	        target.unlink()
    47	        os.symlink(".arch-real.md", target)
    48	        self.assertEqual(target.read_bytes(), payload, "the symlink resolves to identical bytes")
    49	
    50	        violations = verify(self.root, [reference])
    51	        kinds = {item["violation"] for item in violations}
    52	        self.assertIn("protected_set_entry_type_changed", kinds)
    53	        changed = next(v for v in violations if v["violation"] == "protected_set_entry_type_changed")
    54	        self.assertEqual(changed["path"], "docs/ARCH.md")
    55	        self.assertEqual((changed["expected"], changed["observed"]), ("file", "symlink"))
    56	        self.assertIn("protected_set_entry_added", kinds)
    57	        self.assertIn("docs/.arch-real.md", {v.get("path") for v in violations})
    58	
    59	        # The same substitution under exact_file_hash is refused before any hash is compared.
    60	        single = [{"pattern": "docs/ARCH.md", "policy": "exact_file_hash",
    61	                   "sha256": plan_validator.sha256_hex(payload)}]
    62	        self.assertEqual([v["violation"] for v in verify(self.root, single)], ["protected_file_type_changed"])
    63	
    64	    def test_exact_set_snapshot_detects_addition_deletion_and_byte_change(self) -> None:
    65	        reference = self.protected_docs()
    66	        self.write("docs/UNTRACKED.md", "slipped in\n")
    67	        self.assertEqual([v["violation"] for v in verify(self.root, [reference])], ["protected_set_entry_added"])
    68	        (self.root / "docs" / "UNTRACKED.md").unlink()
    69	        self.assertEqual(verify(self.root, [reference]), [])
    70	
    71	        self.write("docs/ARCH.md", (self.root / "docs" / "ARCH.md").read_text(encoding="utf-8") + "\n")
    72	        self.assertEqual([v["violation"] for v in verify(self.root, [reference])], ["protected_set_entry_modified"])
    73	
    74	        self.write("docs/ARCH.md", reference["snapshot"]["entries"][0]["path"] and
    75	                   (self.root / "docs" / "ARCH.md").read_text(encoding="utf-8").rstrip("\n") + "\n")
    76	        self.assertEqual(verify(self.root, [reference]), [])
    77	        (self.root / "docs" / "ARCH.md").unlink()
    78	        self.assertEqual([v["violation"] for v in verify(self.root, [reference])], ["protected_set_entry_removed"])
    79	
    80	    def test_read_only_policy_is_verified_against_the_working_tree(self) -> None:
    81	        read_only = [{"pattern": "docs", "policy": "read_only"}]
    82	        self.assertEqual(verify(self.root, read_only), [])
    83	        self.write("docs/ARCH.md", "rewritten\n")
    84	        violations = verify(self.root, read_only)
    85	        self.assertEqual([v["violation"] for v in violations], ["protected_read_only_mutated"])
    86	        self.assertEqual(violations[0]["path"], "docs/ARCH.md")
    87	        # With neither git nor a baseline the answer is a refusal, never a silent pass.
    88	        outside = tempfile.TemporaryDirectory(prefix="tl-no-git-")
