    49	    def auto_story_fixture(self, *, budget: int = 8, max_rework: int = 2, max_calls: int = 8,
    50	                           limits: dict | None = None) -> Fixture:
    51	        fx = Fixture(self.root, units=1, max_calls=max_calls, max_rework=max_rework, limits=limits)
    52	        spec_sha = hashlib.sha256(SPEC_A.encode()).hexdigest()
    53	        payload = story.build_authority_payload(
    54	            authority_id="A001", work_ref="T001", authorized_spec_revision=spec_sha[:16],
    55	            authorized_spec_sha256=spec_sha,
    56	            authorized_write_scope={"required_mutation_targets": ["pkg"],
    57	                                    "conditional_mutation_targets": [],
    58	                                    "forbidden_paths": ["secrets"]},
    59	            allowed_effects={"local_write": True, "local_commit": True, "local_merge": True,
    60	                             "pull_request": False, "push": False, "tag": False, "release": False,
    61	                             "merge": False},
    62	            protected_paths=[], global_model_call_budget=budget, max_child_batches=2,
    63	            max_consecutive_failed_batches=2, wall_clock_deadline="2027-01-01T00:00:00Z",
    64	            hard_stops=["scope_expansion", "model_call_budget_exhausted", "state_integrity"])
    65	        envelope = story.freeze_authority(
    66	            payload,
    67	            authorized_literal=story.authorization_literal("T001", story.root_authority_digest(payload)),
    68	            authority_source="operator-terminal", authorized_at="2026-09-17T09:00:00Z")
    69	        story.publish_authority(fx.repo, envelope)
    70	        git(fx.repo, "add", "-A")
    71	        git(fx.repo, "commit", "-q", "-m", "freeze story authority A001")
    72	
    73	        with story.StoryAuthority.open_for(fx.repo, "A001") as authority:
    74	            proposal = story.derive_child_proposal(
    75	                authority=authority, child_batch_id="B001", action_items=[], previous_child_id=None,
    76	                model_call_budget=budget, governance_base_commit=git(fx.repo, "rev-parse", "HEAD"),
    77	                story_baseline_commit=git(fx.repo, "rev-parse", "HEAD"))
    78	            proof = story.verify_derivation(authority, proposal)
    79	            authority.record_child_derived(proposal, proof)
    80	
    81	        fx.batch["authorization"].update({
    82	            "story_authority_mode": "AUTO_STORY", "story_authority_id": "A001",
