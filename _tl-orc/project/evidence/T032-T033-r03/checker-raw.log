   990	    def assert_failure_streak(self) -> None:
   991	        limit = int(self.payload["max_consecutive_failed_batches"])
   992	        if self.state.consecutive_failures >= limit:
   993	            self.hard_stop("consecutive_batch_failures_exhausted",
   994	                           f"{self.state.consecutive_failures} consecutive child batches closed without progress "
   995	                           f"(limit {limit})")
   996	
   997	    # ---- terminal states ---------------------------------------------------------------
   998	
   999	    def hard_stop(self, reason: str, detail: str = "", **evidence: Any) -> None:
  1000	        """Journal the stop and raise. AUTO_STORY never recovers from a hard stop on its own."""
  1001	        if self._lease is not None:
  1002	            self.journal.append("hard_stop", authority_id=self.authority_id, reason=reason, detail=detail[:400],
  1003	                                evidence=evidence)
  1004	            self.refold()
  1005	            self.write_status()
  1006	        raise HardStop(reason, detail, **evidence)
  1007	
  1008	    def close_authority(self, *, state: str = "done", reason: str = "") -> dict:
  1009	        self._require_lease()
  1010	        self.refold()
  1011	        if self.state.closed:
  1012	            return self.state.children  # already terminal; closing twice changes nothing
  1013	        event = self.journal.append("authority_closed", authority_id=self.authority_id, state=state, reason=reason)
  1014	        self.refold()
  1015	        self.write_status()
  1016	        return event
  1017	
  1018	    # ---- projection ---------------------------------------------------------------------
  1019	
  1020	    def status_projection(self) -> dict:
  1021	        state = self.state
  1022	        return {
  1023	            "schema_version": 1,
  1024	            "projection_of": "journal.jsonl",
  1025	            "authority_id": self.authority_id,
  1026	            "authority_mode": AUTHORITY_MODE,
  1027	            "work_ref": self.payload["work_ref"],
  1028	            "root_authority_digest": self.root_digest,
  1029	            "opened": state.opened,
  1030	            "closed": state.closed,
  1031	            "close_state": state.close_state,
  1032	            "close_reason": state.close_reason,
  1033	            "budget": {
