  1940	    print(json.dumps(present_for_authorization(payload), indent=2, ensure_ascii=False))
     1	#!/usr/bin/env python3
     2	"""Execution Plan Validator and first-class Protected Paths (T033).
     3	
     4	An execution plan is the machine-checkable part of a proposal: which gates run, in which
     5	lifecycle phase, and which assertions each gate evaluates. Assertions are not free strings.
     6	They are identifiers in a closed registry that also declares, per assertion, the lifecycle
     7	phases in which evaluating it is meaningful. An assertion nobody registered, or one placed
     8	in a phase where its answer is not yet decidable, is refused; the validator never guesses.
     9	
    10	Protected paths are first class here for the same reason: `read_only`, `exact_file_hash`
    11	and `exact_set_snapshot` are verified against the tree, and their policy can only ever be
    12	inherited or tightened, never relaxed.
    13	
    14	Everything in this module is the Python standard library. Schema validation is performed by
    15	a strict Draft 2020-12 subset validator that refuses any keyword it does not implement, so
    16	a schema can never rely on semantics this validator silently skips.
    17	"""
    18	
    19	from __future__ import annotations
    20	
    21	import argparse
    22	import hashlib
    23	import json
    24	import os
    25	import re
    26	import subprocess
    27	import sys
    28	from pathlib import Path
    29	from typing import Any
    30	
    31	# --------------------------------------------------------------------------- canonical form
    32	
    33	# canonical_json_v1: UTF-8, object keys sorted lexicographically, compact deterministic
    34	# separators, no incidental whitespace, array order preserved. No float is admitted: a
    35	# digest that depends on a binary floating point representation is not a digest.
    36	
    37	
    38	def canonical_json(payload: Any) -> str:
    39	    _reject_floats(payload, "$")
    40	    return json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    41	
    42	
    43	def _reject_floats(value: Any, path: str) -> None:
    44	    if isinstance(value, float):
    45	        raise ValueError(f"{path}: float values are not admitted in canonical JSON")
    46	    if isinstance(value, dict):
    47	        for key, item in value.items():
    48	            if not isinstance(key, str):
    49	                raise ValueError(f"{path}: object keys must be strings, got {type(key).__name__}")
    50	            _reject_floats(item, f"{path}.{key}")
    51	    elif isinstance(value, (list, tuple)):
    52	        for index, item in enumerate(value):
    53	            _reject_floats(item, f"{path}[{index}]")
    54	
    55	
    56	def sha256_hex(data: str | bytes) -> str:
    57	    return hashlib.sha256(data.encode("utf-8") if isinstance(data, str) else data).hexdigest()
    58	
    59	
    60	def digest_of(payload: Any) -> str:
    61	    return sha256_hex(canonical_json(payload))
    62	
    63	
    64	# --------------------------------------------------------------------------- schema subset
    65	
    66	# Every keyword this validator implements. A schema carrying anything else is refused rather
    67	# than validated with the unknown keyword ignored, which is how partial validators quietly
    68	# stop enforcing the constraint an author believed they had written.
    69	SUPPORTED_KEYWORDS = frozenset({
    70	    "$schema", "$id", "$defs", "$ref", "$comment", "title", "description", "default", "examples",
    71	    "deprecated", "readOnly", "writeOnly", "format",
    72	    "type", "enum", "const",
    73	    "required", "properties", "additionalProperties", "patternProperties", "propertyNames",
    74	    "minProperties", "maxProperties", "dependentRequired",
    75	    "items", "prefixItems", "minItems", "maxItems", "uniqueItems", "contains", "minContains", "maxContains",
    76	    "minLength", "maxLength", "pattern",
    77	    "minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "multipleOf",
    78	    "allOf", "anyOf", "oneOf", "not", "if", "then", "else",
    79	})
    80	# Annotation-only in Draft 2020-12: recorded, never asserted. Listed so the intent is explicit.
    81	ANNOTATION_KEYWORDS = frozenset({
    82	    "$schema", "$id", "$comment", "title", "description", "default", "examples",
    83	    "deprecated", "readOnly", "writeOnly", "format", "$defs",
    84	})
    85	
    86	
    87	class SchemaError(ValueError):
    88	    """The schema itself is unusable; validating against it would prove nothing."""
    89	
    90	
    91	def _resolve_ref(node: Any, root: dict, seen: tuple = ()) -> dict:
    92	    while isinstance(node, dict) and "$ref" in node:
    93	        ref = node["$ref"]
    94	        if not isinstance(ref, str) or not ref.startswith("#/"):
    95	            raise SchemaError(f"unsupported $ref {ref!r}: only local JSON pointers are implemented")
    96	        if ref in seen:
    97	            raise SchemaError(f"cyclic $ref chain through {ref!r}")
    98	        seen = seen + (ref,)
    99	        target: Any = root
   100	        for token in ref[2:].split("/"):
   101	            token = token.replace("~1", "/").replace("~0", "~")
   102	            if not isinstance(target, dict) or token not in target:
   103	                raise SchemaError(f"unresolvable $ref {ref!r}")
   104	            target = target[token]
   105	        node = target
   106	    if isinstance(node, bool):
   107	        return {} if node else {"not": {}}
   108	    if not isinstance(node, dict):
   109	        raise SchemaError(f"schema node must be an object or boolean, got {type(node).__name__}")
   110	    return node
   111	
   112	
   113	def _type_matches(value: Any, name: str) -> bool:
   114	    if name == "object":
   115	        return isinstance(value, dict)
   116	    if name == "array":
   117	        return isinstance(value, list)
   118	    if name == "string":
   119	        return isinstance(value, str)
   120	    if name == "integer":
   121	        return isinstance(value, int) and not isinstance(value, bool)
   122	    if name == "number":
   123	        return isinstance(value, (int, float)) and not isinstance(value, bool)
   124	    if name == "boolean":
   125	        return isinstance(value, bool)
   126	    if name == "null":
   127	        return value is None
   128	    raise SchemaError(f"unknown type name {name!r}")
   129	
   130	
   131	def _equal(left: Any, right: Any) -> bool:
   132	    """JSON equality: 1 and true are different values even though Python compares them equal."""
   133	    if isinstance(left, bool) != isinstance(right, bool):
   134	        return False
   135	    if isinstance(left, dict) and isinstance(right, dict):
   136	        return left.keys() == right.keys() and all(_equal(left[k], right[k]) for k in left)
   137	    if isinstance(left, list) and isinstance(right, list):
   138	        return len(left) == len(right) and all(_equal(a, b) for a, b in zip(left, right))
   139	    return left == right
   140	
   141	
   142	def validate_json_schema(value: Any, schema: Any, root: dict | None = None, path: str = "$") -> list[str]:
   143	    """Validate `value` against a Draft 2020-12 subset. Returns every error found."""
   144	    root = root if root is not None else (schema if isinstance(schema, dict) else {})
   145	    node = _resolve_ref(schema, root)
   146	    unsupported = sorted(set(node) - SUPPORTED_KEYWORDS)
   147	    if unsupported:
   148	        raise SchemaError(f"{path}: unsupported schema keyword(s) {unsupported}")
   149	    errors: list[str] = []
   150	
   151	    if "const" in node and not _equal(value, node["const"]):
   152	        return [f"{path}: expected const {node['const']!r}, got {value!r}"]
   153	    if "enum" in node and not any(_equal(value, option) for option in node["enum"]):
   154	        return [f"{path}: value {value!r} is not one of {node['enum']!r}"]
   155	    if "type" in node:
   156	        names = node["type"] if isinstance(node["type"], list) else [node["type"]]
   157	        if not any(_type_matches(value, name) for name in names):
   158	            return [f"{path}: expected type {node['type']!r}, got {type(value).__name__}"]
   159	
   160	    if isinstance(value, str):
   161	        if "minLength" in node and len(value) < node["minLength"]:
   162	            errors.append(f"{path}: string shorter than minLength {node['minLength']}")
   163	        if "maxLength" in node and len(value) > node["maxLength"]:
   164	            errors.append(f"{path}: string longer than maxLength {node['maxLength']}")
   165	        if "pattern" in node and re.search(node["pattern"], value) is None:
   166	            errors.append(f"{path}: {value!r} does not match pattern {node['pattern']!r}")
   167	
   168	    if isinstance(value, (int, float)) and not isinstance(value, bool):
   169	        if "minimum" in node and value < node["minimum"]:
   170	            errors.append(f"{path}: {value} < minimum {node['minimum']}")
   171	        if "maximum" in node and value > node["maximum"]:
   172	            errors.append(f"{path}: {value} > maximum {node['maximum']}")
   173	        if "exclusiveMinimum" in node and value <= node["exclusiveMinimum"]:
   174	            errors.append(f"{path}: {value} <= exclusiveMinimum {node['exclusiveMinimum']}")
   175	        if "exclusiveMaximum" in node and value >= node["exclusiveMaximum"]:
   176	            errors.append(f"{path}: {value} >= exclusiveMaximum {node['exclusiveMaximum']}")
   177	        if "multipleOf" in node and node["multipleOf"] and value % node["multipleOf"] != 0:
   178	            errors.append(f"{path}: {value} is not a multiple of {node['multipleOf']}")
   179	
   180	    if isinstance(value, list):
   181	        prefix = node.get("prefixItems") or []
   182	        for index, item in enumerate(value):
   183	            if index < len(prefix):
   184	                errors.extend(validate_json_schema(item, prefix[index], root, f"{path}[{index}]"))
   185	            elif "items" in node:
   186	                errors.extend(validate_json_schema(item, node["items"], root, f"{path}[{index}]"))
   187	        if "minItems" in node and len(value) < node["minItems"]:
   188	            errors.append(f"{path}: array shorter than minItems {node['minItems']}")
   189	        if "maxItems" in node and len(value) > node["maxItems"]:
   190	            errors.append(f"{path}: array longer than maxItems {node['maxItems']}")
   191	        if node.get("uniqueItems"):
   192	            for i in range(len(value)):
   193	                if any(_equal(value[i], value[j]) for j in range(i)):
   194	                    errors.append(f"{path}[{i}]: duplicate item violates uniqueItems")
   195	                    break
   196	        if "contains" in node:
   197	            matches = sum(1 for item in value if not validate_json_schema(item, node["contains"], root, path))
   198	            if matches < int(node.get("minContains", 1)):
   199	                errors.append(f"{path}: fewer than minContains {node.get('minContains', 1)} matching items")
   200	            if "maxContains" in node and matches > int(node["maxContains"]):
   201	                errors.append(f"{path}: more than maxContains {node['maxContains']} matching items")
   202	
   203	    if isinstance(value, dict):
   204	        properties = node.get("properties") or {}
   205	        patterns = node.get("patternProperties") or {}
   206	        for name in node.get("required") or []:
   207	            if name not in value:
   208	                errors.append(f"{path}: missing required property {name!r}")
   209	        if "minProperties" in node and len(value) < node["minProperties"]:
   210	            errors.append(f"{path}: fewer than minProperties {node['minProperties']}")
   211	        if "maxProperties" in node and len(value) > node["maxProperties"]:
   212	            errors.append(f"{path}: more than maxProperties {node['maxProperties']}")
   213	        for name, required in (node.get("dependentRequired") or {}).items():
   214	            if name in value:
   215	                for dependent in required:
   216	                    if dependent not in value:
   217	                        errors.append(f"{path}: property {name!r} requires {dependent!r}")
   218	        additional = node.get("additionalProperties", True)
   219	        for name, item in value.items():
   220	            matched = False
   221	            if name in properties:
   222	                errors.extend(validate_json_schema(item, properties[name], root, f"{path}.{name}"))
   223	                matched = True
   224	            for expression, subschema in patterns.items():
   225	                if re.search(expression, name):
   226	                    errors.extend(validate_json_schema(item, subschema, root, f"{path}.{name}"))
   227	                    matched = True
   228	            if not matched:
   229	                if additional is False:
   230	                    errors.append(f"{path}: unexpected additional property {name!r}")
   231	                elif additional is not True:
   232	                    errors.extend(validate_json_schema(item, additional, root, f"{path}.{name}"))
   233	            if "propertyNames" in node:
   234	                errors.extend(validate_json_schema(name, node["propertyNames"], root, f"{path}:name({name})"))
   235	
   236	    for subschema in node.get("allOf") or []:
   237	        errors.extend(validate_json_schema(value, subschema, root, path))
   238	    if "anyOf" in node and not any(not validate_json_schema(value, s, root, path) for s in node["anyOf"]):
   239	        errors.append(f"{path}: value matches no branch of anyOf")
   240	    if "oneOf" in node:
   241	        matched = sum(1 for s in node["oneOf"] if not validate_json_schema(value, s, root, path))
   242	        if matched != 1:
   243	            errors.append(f"{path}: expected exactly one matching oneOf branch, matched {matched}")
   244	    if "not" in node and not validate_json_schema(value, node["not"], root, path):
   245	        errors.append(f"{path}: value must not match the 'not' subschema")
   246	    if "if" in node:
   247	        branch = "then" if not validate_json_schema(value, node["if"], root, path) else "else"
   248	        if branch in node:
   249	            errors.extend(validate_json_schema(value, node[branch], root, path))
   250	    return errors
   251	
