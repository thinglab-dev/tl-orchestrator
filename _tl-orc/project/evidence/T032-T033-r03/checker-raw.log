AUTHORIZATION_LITERAL_RE = re.compile(r"^AUTORIZO STORY (?P<work_ref>\S+) sha256:(?P<digest>[0-9a-f]{64})\Z")
_COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
_TIMESTAMP_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")

