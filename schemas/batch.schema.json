{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tl-orchestrator Batch Envelope Schema",
  "description": "Validates the frontmatter YAML envelope of _tl-orc/project/batches/Bnnn.md under Automatic Mode (T018).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "batch_revision",
    "authorization",
    "frozen_scope",
    "budget",
    "execution"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^B[0-9]{3,}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "done",
        "blocked",
        "stopped",
        "failed",
        "cancelled"
      ]
    },
    "batch_revision": {
      "type": "integer",
      "minimum": 1
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "proposal_digest",
        "authority_source",
        "authorized_at",
        "permitted_effects",
        "continue_independent_after_block"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_digest": {
          "type": "string",
          "minLength": 1
        },
        "authority_source": {
          "type": "string",
          "minLength": 1
        },
        "authorized_at": {
          "type": "string",
          "minLength": 1
        },
        "permitted_effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local_write",
            "local_commit",
            "local_merge",
            "pull_request",
            "push",
            "tag",
            "release"
          ],
          "properties": {
            "local_write": {
              "type": "boolean"
            },
            "local_commit": {
              "type": "boolean"
            },
            "local_merge": {
              "type": "boolean"
            },
            "pull_request": {
              "type": "boolean"
            },
            "push": {
              "type": "boolean"
            },
            "tag": {
              "type": "boolean"
            },
            "release": {
              "type": "boolean"
            },
            "pull_request_merge": {
              "type": "boolean",
              "description": "Optional since v0.17.0, amended in T028: technical capability flag only. Actual merge execution strictly requires an out-of-band merge execution authority envelope. Absent means false."
            },
            "ci_rerun": {
              "type": "boolean",
              "description": "Optional since v0.17.0: the durable runtime may re-run failed CI jobs once per unit when the failure looks like infrastructure. Absent means false."
            }
          }
        },
        "continue_independent_after_block": {
          "type": "boolean"
        }
      }
    },
    "frozen_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_concurrency",
        "advisor_policy",
        "units",
        "integration_groups",
        "major_boundaries",
        "stop_conditions",
        "immutable_digest"
      ],
      "properties": {
        "batch_concurrency": {
          "const": 1
        },
        "advisor_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "triggers",
            "max_calls"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "triggers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "architecture_or_contract_change",
                  "hard_to_reverse_decision",
                  "governance_experiment",
                  "heavy_tier_material_uncertainty",
                  "causal_claim_limited_evidence",
                  "recurring_failure_class_independent_review",
                  "explicit_user_request",
                  "pre_freeze_high_cost_batch"
                ]
              }
            },
            "max_calls": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "work_ref",
              "revision",
              "spec_revision",
              "integration_group",
              "dependencies"
            ],
            "properties": {
              "work_ref": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "spec_revision": {
                "type": "string",
                "minLength": 1
              },
              "integration_group": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "checker_approved_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "description": "T028: exact Git commit SHA audited and approved by the independent Checker."
              },
              "integration_candidate_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "description": "T028: exact Git commit SHA prepared for merge after post-review governance delta."
              },
              "authority_mode": {
                "type": "string",
                "enum": [
                  "delegated_single_merge",
                  "human_merge_only"
                ],
                "description": "T028: operational authority mode for merge execution."
              },
              "authorization_id": {
                "type": "string",
                "pattern": "^auth-[0-9a-f]{32}$",
                "description": "T028: unique identifier of the out-of-band merge authorization envelope."
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "authority_mode"
                  ],
                  "properties": {
                    "authority_mode": {
                      "const": "delegated_single_merge"
                    }
                  }
                },
                "then": {
                  "required": [
                    "checker_approved_commit",
                    "integration_candidate_commit"
                  ]
                }
              }
            ]
          }
        },
        "integration_groups": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "major_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "gate"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "gate": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "authority_missing_or_ambiguous",
              "scope_expansion",
              "new_work_outside_frozen_batch",
              "model_call_budget_exhausted",
              "rework_limit_exhausted",
              "insufficient_budget_for_unit_verification",
              "required_checker_independence_unavailable",
              "required_advisor_independence_unavailable",
              "advisor_verdict_stop",
              "advisor_verdict_debate",
              "bad_spec_or_intent_gap",
              "canonical_full_gate_failure",
              "coordinator_conflict",
              "unexpected_tree_state",
              "unexpected_revision_drift",
              "external_effect_not_authorized",
              "unrecoverable_harness_failure",
              "dependency_block"
            ]
          }
        },
        "immutable_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_calls",
        "consumed_model_calls",
        "reserved_model_calls",
        "max_rework_rounds_per_unit",
        "max_advisor_calls",
        "consumed_advisor_calls",
        "pending_call"
      ],
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 1
        },
        "consumed_model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_rework_rounds_per_unit": {
          "type": "integer",
          "minimum": 0
        },
        "max_advisor_calls": {
          "type": "integer",
          "minimum": 0
        },
        "consumed_advisor_calls": {
          "type": "integer",
          "minimum": 0
        },
        "pending_call": {
          "type": [
            "null",
            "object"
          ],
          "additionalProperties": false,
          "required": [
            "call_id",
            "role",
            "phase"
          ],
          "properties": {
            "call_id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "enum": [
                "classifier",
                "planner",
                "maker",
                "checker",
                "advisor",
                "searcher"
              ]
            },
            "phase": {
              "type": "string",
              "enum": [
                "debate",
                "planning",
                "implementation",
                "review",
                "rework"
              ]
            },
            "payload_digest": {
              "type": "string"
            },
            "dispatched_at": {
              "type": "string"
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_unit",
        "current_phase",
        "current_round",
        "expected_tree_checkpoint",
        "completed_units",
        "stop_reason"
      ],
      "properties": {
        "current_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_round": {
          "type": "integer",
          "minimum": 0
        },
        "expected_tree_checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "completed_units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_refs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "supervisor_state_dir": {
              "type": [
                "string",
                "null"
              ]
            },
            "worktree_slot": {
              "type": [
                "string",
                "null"
              ]
            },
            "scope_claim": {
              "type": [
                "string",
                "null"
              ]
            },
            "merge_queue_entry": {
              "type": [
                "string",
                "null"
              ]
            },
            "lease_heartbeat_ts": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "frozen_scope"
        ],
        "properties": {
          "frozen_scope": {
            "type": "object",
            "required": [
              "advisor_policy"
            ],
            "properties": {
              "advisor_policy": {
                "type": "object",
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "budget"
        ],
        "properties": {
          "budget": {
            "type": "object",
            "required": [
              "consumed_advisor_calls"
            ],
            "properties": {
              "consumed_advisor_calls": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
