    24	    def assert_hard_stop(self, auth, proposal, reason: str, **kwargs) -> story.HardStop:
    25	        before = len(auth.state.derived)
    26	        with self.assertRaises(story.HardStop) as raised:
    27	            story.verify_derivation(auth, proposal, **kwargs)
    28	        self.assertEqual(raised.exception.reason, reason, raised.exception.detail)
    29	        auth.refold()
    30	        self.assertEqual(len(auth.state.derived), before, "a refused derivation must open no child batch")
    31	        self.assertTrue(auth.state.hard_stops, "the refusal must be journaled")
    32	        self.assertEqual(auth.state.hard_stops[-1]["reason"], reason)
    33	        return raised.exception
