    "HOME", "USERPROFILE", "APPDATA", "LOCALAPPDATA", "PROGRAMDATA", "PROGRAMFILES", "USERNAME",
    "USER", "LANG", "LC_ALL", "LC_CTYPE", "TERM", "SHELL", "PYTHONIOENCODING", "PYTHONUTF8",
    "GOFLAGS", "GOPATH", "GOCACHE", "GOMODCACHE", "NO_COLOR", "CI",
