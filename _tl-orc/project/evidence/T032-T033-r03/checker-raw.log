   981	    def record_child_failed(self, child_batch_id: str, *, reason: str, detail: str = "") -> dict:
   982	        self._require_lease()
   983	        event = self.journal.append(
   984	            "child_failed", authority_id=self.authority_id, child_batch_id=child_batch_id, reason=reason,
   985	            detail=detail[:400])
   986	        self.refold()
   987	        self.write_status()
