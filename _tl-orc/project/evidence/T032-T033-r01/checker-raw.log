  1443	    def budgeted_dispatch(self, role: str, step_id: str, phase: str, payload_digest: str, dispatch) -> dict:
  1444	        """Every control-plane model call goes through here. Under AUTO_STORY it is also the only
  1445	        place the global Story budget is reserved and settled, so a physical provider attempt is
  1446	        charged exactly once even though it also appears in this child batch's ledger."""
  1447	        if self.authority is None:
  1448	            return dispatch()
  1449	        context = story_authority.AuthorityDispatchContext(self.authority, self.batch_id, step_id)
  1450	        try:
  1451	            context.reserve(role=role, phase=phase, payload_digest=payload_digest)
  1452	        except story_authority.HardStop as stop:
  1453	            raise StopBatch(stop.reason, stop.detail) from stop
  1454	        try:
  1455	            record = dispatch()
  1456	        except BaseException:
  1457	            # The call may already have reached the provider: never released on doubt.
  1458	            context.consume(outcome="ambiguous", receipt={"detail": "dispatch raised before a receipt was observed"})
  1459	            raise
  1460	        state = str((record or {}).get("state", ""))
  1461	        if state in NO_DISPATCH_STATES:
  1462	            context.release(proof=f"transport state {state!r}: the dispatch never started")
  1463	        elif state in {"indeterminate", "unknown", "running", ""}:
  1464	            context.consume(outcome="ambiguous", receipt={"state": state})
  1465	        else:
  1466	            context.consume(outcome="consumed", receipt={"state": state})
  1467	        record["global_attempt_id"] = context.global_attempt_id
  1468	        return record
