  1318	    def _bind_and_verify_auto_story_child(self) -> None:
  1319	        """Bind the executable batch to one persisted, verified child derivation (T032)."""
  1320	        # The authority journal is the source of truth. A batch-supplied digest or an arbitrary
  1321	        # proposal file beside the batch is not authority. Recover the objects that were actually
  1322	        # derived, re-hash them, and then bind the executable batch to that exact proposal.
