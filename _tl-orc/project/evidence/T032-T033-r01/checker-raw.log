   260	        """Re-running a blocked batch must not re-count the child against the failure streak."""
   261	        fx = self.auto_story_fixture(budget=6, max_rework=1, max_calls=6, limits={"stagnation_rounds": 6})
   262	        fx.script("maker", MAKER_OK)
   263	        fx.script("checker", [{"verdict": "changes_requested", "action_items": [PATCH_ITEM]}])
   264	        self.assertEqual(fx.runtime().run(), "blocked")
   265	        authority = self.authority(fx)
   266	        authority.state = authority.journal.fold()
   267	        streak = authority.state.consecutive_failures
   268	        terminal = [e for e in authority.journal.read()[0] if e["kind"] in {"child_closed", "child_failed"}]
   269	        self.assertEqual(len(terminal), 1)
