name: Validate repository

on:
  pull_request:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout without persisted credentials
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Validate repository structure
        run: python3 scripts/validate_repository.py
      - name: Run behavior tests for the optional supervisor
        # This runner is Linux, so it exercises the POSIX branch of job tree
        # containment, including the descendant case in ContainmentTest.
        run: python3 -m unittest discover -s tests -p "test_*.py" -v
      - name: Run contractual and domain test suites
        run: python3 -m unittest discover -s scripts/tests -p "test_*.py" -v
      - name: Run mechanical lineage and governance audit
        run: python3 scripts/audit_lineage.py
