   125	    def test_parent_conditional_path_can_become_child_required(self) -> None:
   126	        """9. §2.4: the union is what must be contained, so a conditional path may become required."""
   127	        auth = self.authority()
   128	        scope = auth.payload["authorized_write_scope"]
   129	        self.assertIn("tests/test_connector.py", scope["conditional_mutation_targets"])
   130	        self.assertNotIn("tests/test_connector.py", scope["required_mutation_targets"])
   131	
   132	        residual = [
   133	            self.patch_item("R5", location="src/connector.py:118"),
   134	            self.patch_item("R6", location="tests/test_connector.py:64"),
   135	        ]
   136	        child = story.derive_child_proposal(
   137	            authority=auth, child_batch_id="B013", action_items=residual, previous_child_id=None,
   138	            model_call_budget=6, governance_base_commit=self.governance_base,
   139	            story_baseline_commit=self.governance_base)
   140	        # The factual finding on a conditional path promoted it to required in the child.
   141	        self.assertEqual(child["required_mutation_targets"], ["src/connector.py", "tests/test_connector.py"])
   142	        promoted = set(child["required_mutation_targets"]) - set(scope["required_mutation_targets"])
   143	        self.assertEqual(promoted, {"tests/test_connector.py"})
   144	
   145	        proof = story.verify_derivation(auth, child, action_items=residual, spec_paths=SPEC_PATHS)
   146	        self.assertEqual({check["check"]: check["result"] for check in proof["checks"]}["scope_subset"], "pass")
   147	
   148	        # The union rule accepts it; a path in neither parent set is still refused.
   149	        outside = copy.deepcopy(child)
   150	        outside["required_mutation_targets"] = ["src/connector.py", "infra/terraform/main.tf"]
   151	        self.assert_hard_stop(auth, outside, "scope_expansion")
