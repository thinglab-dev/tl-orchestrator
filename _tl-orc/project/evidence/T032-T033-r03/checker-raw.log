  1191	def derive_child_proposal(
  1192	    *,
  1193	    authority: "StoryAuthority",
  1194	    child_batch_id: str,
  1195	    action_items: list[dict],
  1196	    previous_child_id: str | None = None,
  1197	    model_call_budget: int | None = None,
  1198	    required_mutation_targets: Iterable[str] | None = None,
  1199	    conditional_mutation_targets: Iterable[str] | None = None,
  1200	    governance_base_commit: str,
  1201	    story_baseline_commit: str,
  1202	) -> dict:
  1203	    """Formulate the next child deterministically from the parent envelope and the residual findings.
  1204	
  1205	    Targets the findings actually name become `required`; everything the parent authorized stays
  1206	    available as `conditional`. A path the parent authorized only conditionally may become required
  1207	    here, which is exactly what a factual Checker finding does to it.
  1208	    """
  1209	    payload = authority.payload
  1210	    state = authority.refold()
  1211	    scope = payload["authorized_write_scope"]
  1212	    if required_mutation_targets is None:
  1213	        named: list[str] = []
  1214	        for item in action_items:
  1215	            named.extend(_item_locations(item))
  1216	        authorized = _scope_paths(scope)
  1217	        required = sorted({path for path in named if _within(path, authorized)})
  1218	        required_mutation_targets = required or sorted(scope.get("required_mutation_targets") or [])
  1219	    required_list = sorted(set(required_mutation_targets))
  1220	    if conditional_mutation_targets is None:
  1221	        conditional_mutation_targets = [p for p in _scope_paths(scope) if p not in required_list]
  1222	    previous_closure = state.closure_of(previous_child_id) if previous_child_id else None
  1223	    checkpoint = None
  1224	    if previous_closure:
  1225	        checkpoint = {
  1226	            "commit": previous_closure["checker_reviewed_commit"],
  1227	            "tree": previous_closure["checker_reviewed_tree"],
  1228	            "child_batch_id": previous_closure["child_batch_id"],
  1229	        }
  1230	    granted = int(model_call_budget) if model_call_budget is not None else authority.remaining_global_budget
  1231	    proposal = {
  1232	        "schema_version": 1,
  1233	        "child_batch_id": child_batch_id,
  1234	        "authority_id": authority.authority_id,
  1235	        "parent_child_batch_id": previous_child_id,
  1236	        "work_ref": payload["work_ref"],
  1237	        "authorized_spec_revision": payload["authorized_spec_revision"],
  1238	        "authorized_spec_sha256": payload["authorized_spec_sha256"],
  1239	        "required_mutation_targets": required_list,
  1240	        "conditional_mutation_targets": sorted(set(conditional_mutation_targets)),
  1241	        "forbidden_paths": sorted(set(scope.get("forbidden_paths") or [])),
  1242	        "protected_paths": list(payload.get("protected_paths") or []),
  1243	        "allowed_effects": dict(payload["allowed_effects"]),
  1244	        "model_call_budget": max(1, granted),
  1245	        "functional_parent_checkpoint": checkpoint,
  1246	        "derived_from_action_items": [
  1247	            {"id": str(item.get("id", "")), "category": str(item.get("category", "")),
  1248	             "target_role": str(item.get("target_role", "")), "location": str(item.get("location", "")),
  1249	             "required_action": str(item.get("required_action", "")),
  1250	             **({"severity": str(item["severity"])} if item.get("severity") else {})}
  1251	            for item in sorted(action_items, key=lambda entry: str(entry.get("id", "")))
  1252	        ],
  1253	        "lineage": {"governance_base_commit": governance_base_commit, "story_baseline_commit": story_baseline_commit},
  1254	    }
  1255	    valid, errors = validate_against_schema_file(proposal, CHILD_PROPOSAL_SCHEMA)
  1256	    if not valid:
  1257	        raise Refusal(f"derived child proposal violates its schema: {errors}")
  1258	    return proposal
