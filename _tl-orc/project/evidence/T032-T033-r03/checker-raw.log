  1261	def assert_child_proposal_within_envelope(
  1262	    proposal: dict,
  1263	    payload: dict,
  1264	    state: Any = None,
  1265	    authority: Any = None,
  1410	def verify_derivation(
  1411	    authority: "StoryAuthority",
  1412	    child_proposal: dict,
  1413	    *,
  1414	    action_items: list[dict] | None = None,
