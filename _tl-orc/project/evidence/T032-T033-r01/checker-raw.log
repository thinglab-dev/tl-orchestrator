   167	class SchemaSubsetValidatorTest(unittest.TestCase):
   168	    """The validator must refuse a schema it cannot fully enforce, never quietly ignore it."""
   169	
   170	    def test_unsupported_keyword_is_refused_rather_than_ignored(self) -> None:
   171	        schema = {"type": "object", "unevaluatedProperties": False}
   172	        with self.assertRaises(plan_validator.SchemaError) as raised:
   173	            plan_validator.validate_json_schema({}, schema, schema)
   174	        self.assertIn("unsupported schema keyword", str(raised.exception))
   175	        ok, errors = plan_validator.validate_against_schema_file({}, FIXTURES / "does-not-exist.json")
   176	        self.assertFalse(ok)
   177	        self.assertIn("schema unavailable", errors[0])
   178	
   179	    def test_conditional_and_combinator_keywords_are_really_enforced(self) -> None:
   180	        schema = {
   181	            "type": "object",
   182	            "properties": {"kind": {"enum": ["a", "b"]}, "value": {"type": "integer", "minimum": 1}},
   183	            "required": ["kind"],
   184	            "allOf": [{"if": {"properties": {"kind": {"const": "a"}}, "required": ["kind"]},
   185	                       "then": {"required": ["value"]}}],
   186	        }
   187	        self.assertEqual(plan_validator.validate_json_schema({"kind": "a", "value": 2}, schema, schema), [])
   188	        self.assertTrue(plan_validator.validate_json_schema({"kind": "a"}, schema, schema))
   189	        self.assertEqual(plan_validator.validate_json_schema({"kind": "b"}, schema, schema), [])
   190	
   191	        array = {"type": "array", "items": {"type": "integer"}, "uniqueItems": True, "maxItems": 3}
   192	        self.assertEqual(plan_validator.validate_json_schema([1, 2, 3], array, array), [])
   193	        self.assertTrue(plan_validator.validate_json_schema([1, 1], array, array))
   194	        self.assertTrue(plan_validator.validate_json_schema([1, 2, 3, 4], array, array))
   195	
   196	        # JSON equality: true is not 1, so an integer enum never matches a boolean.
   197	        boolean = {"enum": [1, 2]}
   198	        self.assertTrue(plan_validator.validate_json_schema(True, boolean, boolean))
   199	
   200	    # Keywords whose value is a map from arbitrary names to schemas, not a schema itself.
   201	    NAME_MAPS = ("properties", "$defs", "patternProperties", "dependentRequired")
   202	    # Keywords whose value is a list of schemas.
   203	    SCHEMA_LISTS = ("allOf", "anyOf", "oneOf", "prefixItems")
   204	    # Keywords whose value is a single schema.
   205	    SCHEMA_VALUES = ("items", "contains", "not", "if", "then", "else", "additionalProperties", "propertyNames")
   206	
   207	    def test_every_repository_schema_is_fully_enforceable_by_this_validator(self) -> None:
   208	        checked = 0
   209	        for path in sorted((REPO_ROOT / "schemas").glob("*.schema.json")):
   210	            self.walk(json.loads(path.read_text(encoding="utf-8")), path.name)
   211	            checked += 1
   212	        self.assertGreaterEqual(checked, 16)
   213	
   214	    def walk(self, node, name: str, pointer: str = "$") -> None:
   215	        """Walk only the positions that are schemas, so property names are never read as keywords."""
   216	        if not isinstance(node, dict):
   217	            return
   218	        unsupported = sorted(set(node) - plan_validator.SUPPORTED_KEYWORDS)
   219	        if unsupported:
   220	            self.fail(f"{name}{pointer} uses keyword(s) {unsupported} the stdlib validator does not enforce")
   221	        for keyword in self.NAME_MAPS:
   222	            for key, value in (node.get(keyword) or {}).items():
   223	                self.walk(value, name, f"{pointer}.{keyword}.{key}")
   224	        for keyword in self.SCHEMA_LISTS:
   225	            for index, value in enumerate(node.get(keyword) or []):
   226	                self.walk(value, name, f"{pointer}.{keyword}[{index}]")
   227	        for keyword in self.SCHEMA_VALUES:
   228	            if keyword in node:
   229	                self.walk(node[keyword], name, f"{pointer}.{keyword}")
