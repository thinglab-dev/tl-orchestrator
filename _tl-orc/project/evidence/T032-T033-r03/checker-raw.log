    35	    def test_child_rejects_spec_hash_mutation(self) -> None:
    36	        """5. The authorized specification is frozen for the whole authority."""
    37	        auth = self.authority()
    38	        self.assert_hard_stop(auth, self.base_child(auth, authorized_spec_sha256="b" * 64),
    39	                              "unexpected_revision_drift")
    40	        auth_two = self.authority(self.frozen_authority(authority_id="A002"))
    41	        self.assert_hard_stop(auth_two, self.base_child(auth_two, authorized_spec_revision="3"),
    42	                              "unexpected_revision_drift")
