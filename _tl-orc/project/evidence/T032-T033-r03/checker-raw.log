   360	
   361	        fx.runtime().run()
   362	        authority.state = authority.journal.fold()
   363	        self.assertEqual(authority.state.consecutive_failures, streak)
   364	        terminal = [e for e in authority.journal.read()[0] if e["kind"] in {"child_closed", "child_failed"}]
