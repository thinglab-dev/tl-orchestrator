   253	def validate_against_schema_file(data: Any, schema_path: str | Path) -> tuple[bool, list[str]]:
   254	    """Fail-closed: an unreadable or unusable schema is a validation failure, never a pass."""
   255	    try:
   256	        schema = json.loads(Path(schema_path).read_text(encoding="utf-8"))
   257	    except (OSError, ValueError) as exc:
   258	        return False, [f"schema unavailable at {schema_path}: {exc}"]
   259	    try:
   260	        errors = validate_json_schema(data, schema, schema)
   261	    except SchemaError as exc:
   262	        return False, [f"schema unusable: {exc}"]
   263	    return not errors, errors
