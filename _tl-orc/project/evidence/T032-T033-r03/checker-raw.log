    84	            "child_proposal_digest": proof["child_proposal_digest"],
    85	            "derivation_proof_digest": proof["derivation_proof_digest"],
    86	        })
    87	        fx.batch_path.write_text(json.dumps(fx.batch), encoding="utf-8")
    88	        self.envelope = envelope
    89	        return fx
