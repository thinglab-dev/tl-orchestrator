   234	                self.auth, child_batch_id="B013", logical_call_id="B013-maker-r01", role="maker",
   235	                phase="implementation", dispatch=record_dispatch, global_attempt_id=attempt_id)
   236	            self.assertTrue(replay["replayed"])
   237	            self.assertEqual(replay["attempt_state"], "consumed")
   238	        self.assertEqual(dispatched, [attempt_id], "the physical call must not run again on replay")
   239	        self.assertEqual(self.auth.state.consumed_calls, 1)
