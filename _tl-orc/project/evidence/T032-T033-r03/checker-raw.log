   944	    def record_child_closed(
   945	        self,
   946	        *,
   947	        child_batch_id: str,
   948	        governance_base_commit: str,
   949	        checker_reviewed_commit: str,
   950	        checker_reviewed_tree: str,
   951	        functional_checkpoint_commit: str,
   952	        functional_checkpoint_tree: str,
   953	        checker_verdict: str,
   954	        unresolved_action_items: list[dict] | None = None,
   955	        unresolved_digest: str | None = None,
   956	    ) -> dict:
   957	        """Persist the functional lineage of a closing child, merged or not."""
   958	        self._require_lease()
