    19	def can_symlink(root) -> bool:
    20	    probe = root / ".symlink-probe"
    21	    try:
    22	        os.symlink("target", probe)
    23	    except (OSError, NotImplementedError):
    24	        return False
    25	    probe.unlink()
    26	    return True
