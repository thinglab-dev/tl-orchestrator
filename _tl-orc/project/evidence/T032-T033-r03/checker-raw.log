   997	    # ---- terminal states ---------------------------------------------------------------
   998	
   999	    def hard_stop(self, reason: str, detail: str = "", **evidence: Any) -> None:
  1000	        """Journal the stop and raise. AUTO_STORY never recovers from a hard stop on its own."""
  1001	        if self._lease is not None:
  1002	            self.journal.append("hard_stop", authority_id=self.authority_id, reason=reason, detail=detail[:400],
  1003	                                evidence=evidence)
  1004	            self.refold()
  1005	            self.write_status()
  1006	        raise HardStop(reason, detail, **evidence)
  1007	
  1008	    def close_authority(self, *, state: str = "done", reason: str = "") -> dict:
  1009	        self._require_lease()
  1010	        self.refold()
  1011	        if self.state.closed:
  1012	            return self.state.children  # already terminal; closing twice changes nothing
  1013	        event = self.journal.append("authority_closed", authority_id=self.authority_id, state=state, reason=reason)
  1014	        self.refold()
  1015	        self.write_status()
  1016	        return event
