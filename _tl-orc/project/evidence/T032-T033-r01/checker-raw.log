    31	    def test_execution_plan_validator_rejects_temporal_phase_mismatch(self) -> None:
    32	        """27. An assertion evaluated in a phase where its answer is not decidable is refused."""
    33	        for phase, assertion in (
    34	            ("pre_execution", "checker_approved"),
    35	            ("pre_execution", "merge_commit_exists"),
    36	            ("post_maker_pre_review", "checker_approved"),
    37	            ("post_checker_pre_merge", "origin_synced"),
    38	            ("post_terminal", "main_not_merged"),
    39	            ("post_terminal", "functional_checkpoint_matches"),
    40	        ):
    41	            plan = self.plan()
    42	            registry = plan_validator.ASSERTION_REGISTRY[assertion]
    43	            parameters = {
    44	                "unit": "connector:2-10", "reviewed_commit": "1" * 40, "commit": "2" * 40,
    45	                "tree": "3" * 40, "branch": "main", "remote": "origin", "gate_id": "unit-tests",
    46	                "work_ref": "connector:2-10", "sha256": "a" * 64, "policy_id": "p1", "minimum_remaining": 1,
    47	            }
    48	            plan["gates"] = [{
    49	                "gate_id": "g-under-test", "lifecycle_phase": phase, "model_calls": 0,
    50	                "assertions": [{"assertion_id": assertion,
    51	                                "parameters": {k: parameters[k] for k in registry["required"]}}],
    52	            }]
    53	            result = validate(plan)
    54	            self.assertFalse(result["approved"], f"{assertion} in {phase}")
    55	            self.assertIn("assertion_phase_mismatch", violations(result))
    56	            mismatch = next(e for e in result["errors"] if e["violation"] == "assertion_phase_mismatch")
    57	            self.assertEqual(mismatch["assertion_id"], assertion)
    58	            self.assertEqual(mismatch["lifecycle_phase"], phase)
    59	            self.assertEqual(mismatch["allowed_phases"], list(registry["phases"]))
