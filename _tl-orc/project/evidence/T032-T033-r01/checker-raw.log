   807	        self._require_open()
   808	        event = self.journal.append(
   809	            "child_derived", authority_id=self.authority_id, child_batch_id=proposal["child_batch_id"],
   810	            parent_child_batch_id=proposal.get("parent_child_batch_id"),
   811	            root_authority_digest=proof["root_authority_digest"],
   812	            parent_authority_digest=proof["parent_authority_digest"],
