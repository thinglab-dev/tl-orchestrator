  1333	
  1334	        # The child proposal's forbidden paths are part of the executable containment policy,
  1335	        # not just derivation metadata. Merge them into each Unit so the Maker sees them in its
  1336	        # context pack and the post-Maker dirty-tree check rejects forbidden descendants even
  1337	        # when the unit owns a broader parent directory (for example scope `pkg/` with
  1338	        # forbidden `pkg/secrets/`).
  1339	        forbidden = {str(path) for path in proposal.get("forbidden_paths") or []}
  1340	        for unit in self.units.values():
