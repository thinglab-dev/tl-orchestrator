   498	def assert_protected_paths_monotonic(parent: list[dict], child: list[dict]) -> list[dict]:
   499	    """Semantic monotonicity (T032 §2.15): every inherited pattern keeps an identical policy.
   500	
   501	    Textual presence of the pattern is not enough. For an inherited entry the child must carry
   502	    the same policy and the same policy parameters, so an expected hash or a reference snapshot
   503	    can never be swapped for one that happens to match whatever the child produced.
   504	    """
   505	    violations: list[dict] = []
   506	    child_by_pattern = {str(item.get("pattern", "")): item for item in child}
   507	    for item in parent:
   508	        pattern = str(item.get("pattern", ""))
   509	        policy = item.get("policy")
   510	        inherited = child_by_pattern.get(pattern)
   511	        if inherited is None:
   512	            narrower = sorted(p for p in child_by_pattern if p != pattern and _covers(pattern, p))
   513	            violations.append({
   514	                "pattern": pattern, "policy": policy,
   515	                "violation": "protected_path_coverage_reduced" if narrower else "protected_path_removed",
   516	                "detail": f"pattern narrowed to {narrower}" if narrower else "pattern absent from the child",
   517	            })
   518	            continue
   519	        child_policy = inherited.get("policy")
   520	        if child_policy != policy:
   521	            weaker = _POLICY_STRICTNESS.get(str(child_policy), -1) < _POLICY_STRICTNESS.get(str(policy), -1)
   522	            violations.append({
   523	                "pattern": pattern, "policy": policy,
   524	                "violation": "protected_path_policy_weakened" if weaker else "protected_path_policy_changed",
   525	                "expected": policy, "observed": child_policy,
   526	            })
   527	            continue
   528	        if policy == "exact_file_hash" and inherited.get("sha256") != item.get("sha256"):
   529	            violations.append({"pattern": pattern, "policy": policy,
   530	                               "violation": "protected_path_hash_replaced",
   531	                               "expected": item.get("sha256"), "observed": inherited.get("sha256")})
   532	        if policy == "exact_set_snapshot":
   533	            expected = (item.get("snapshot") or {}).get("digest")
   534	            observed = (inherited.get("snapshot") or {}).get("digest")
   535	            if expected != observed:
   536	                violations.append({"pattern": pattern, "policy": policy,
   537	                                   "violation": "protected_path_snapshot_replaced",
   538	                                   "expected": expected, "observed": observed})
   539	    return violations
