    35	class AutoStoryRuntimeTest(unittest.TestCase):
    36	
    37	    def setUp(self) -> None:
    38	        self.tmp = tempfile.TemporaryDirectory(prefix="tl-auto-story-runtime-")
    39	        self.addCleanup(self.tmp.cleanup)
    40	        self.root = Path(self.tmp.name)
    41	        os.environ["TL_FAKE_GH_STATE"] = str(self.root / "gh.json")
    42	        self.addCleanup(lambda: os.environ.pop("TL_FAKE_GH_STATE", None))
    43	        anchor = temporary_platform_anchor_for_testing({TEST_FIXTURE_KEY_ID: TEST_FIXTURE_PUBLIC_KEY.hex()})
    44	        anchor.__enter__()
    45	        self.addCleanup(anchor.__exit__, None, None, None)
