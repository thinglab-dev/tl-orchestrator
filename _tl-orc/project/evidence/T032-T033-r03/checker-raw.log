    46	        auth = self.authority()
    47	        self.assert_hard_stop(auth, self.base_child(auth, model_call_budget=15), "model_call_budget_exhausted")
    48	
    49	        # Spend eleven of fourteen, then try to hand the child the original ceiling again.
    50	        for index in range(11):
    51	            story.budgeted_authority_dispatch(
    52	                auth, child_batch_id="B013", logical_call_id=f"B013-call-{index}", role="maker",
    53	                phase="implementation", dispatch=lambda _a: {"state": "completed"})
    54	        self.assertEqual(auth.remaining_global_budget, 3)
    55	        self.assert_hard_stop(auth, self.base_child(auth, model_call_budget=14), "model_call_budget_exhausted")
    56	        self.assert_hard_stop(auth, self.base_child(auth, model_call_budget=4), "model_call_budget_exhausted")
    57	        proof = story.verify_derivation(auth, self.base_child(auth, model_call_budget=3))
    58	        self.assertEqual(proof["granted_model_calls"], 3)
